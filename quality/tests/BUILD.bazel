expect_failure_test(
    name = "proof_full_empty_beside_diff_fails",
    pattern = "FAIL: no mutants were generated",
    test = ":proof_full_empty_beside_diff",
)

# A survivor is named in the failure output.
expect_failure_test(
    name = "proof_survivor_is_named_fails",
    pattern = "survived: pkg.x_f__mutmut_3",
    test = ":proof_survivor",
)

# The change set of a branch plus an uncommitted edit (changed, deleted,
# added, binary and quoted paths; deletion-only and appended hunks), and
# the slice of it a unit gets.
mutation_changes_test(
    name = "mutation_changes_test",
    subject = "//quality:mutation_changes",
)

# Slices: a unit's slice of a change set holds the unit's entries without the
# base, so change sets that differ only outside the unit (another base,
# other files) give byte-identical slices and the unit's mutation action
# stays cached. A unit untouched by the change set gets the empty slice, and
# no change set at all gives no slice (a full run).
SLICE_UNIT = glob(["testdata/slice/unit/*"])

SLICE_OTHER = glob(["testdata/slice/other/*"])

[
    changes_slice(
        name = "{}_{}".format(unit, pr),
        srcs = files,
        changes = "testdata/slice/{}.json".format(pr),
    )
    for unit, files in {
        "other": SLICE_OTHER,
        "unit": SLICE_UNIT,
    }.items()
    for pr in [
        "pr1",
        "pr2",
    ]
]

changes_slice(
    name = "unit_without_changes",
    srcs = SLICE_UNIT,
    changes = "//quality:no_changes",
)

[
    diff_test(
        name = name,
        file1 = file1,
        file2 = file2,
    )
    for name, file1, file2 in [
        ("slice_keeps_the_unit_entries_test", ":unit_pr1", "testdata/slice/unit.json"),
        ("slice_is_stable_across_diffs_test", ":unit_pr1", ":unit_pr2"),
        ("slice_of_an_untouched_unit_is_empty_test", ":other_pr1", "testdata/slice/empty.json"),
        ("slice_of_an_untouched_unit_is_stable_test", ":other_pr1", ":other_pr2"),
        ("slice_without_changes_is_none_test", ":unit_without_changes", "testdata/slice/none.txt"),
    ]
]
