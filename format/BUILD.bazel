load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//repo:defs.bzl", "repo_files")
load(":defs.bzl", "formatter")

repo_files()

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//format/private:format"],
)

# Formatters for the pinned tools. Each reads its config from the tree, as
# it would when run by hand: .editorconfig (shfmt), tombi.toml, .rumdl.toml,
# .ryl.toml.

formatter(
    name = "shfmt",
    include = [
        "*.sh",
        "*.bash",
        "*.bats",
    ],
    check_args = ["-d"],
    fix_args = ["-w"],
    tool = "@multitool//tools/shfmt",
    visibility = ["//visibility:public"],
)

formatter(
    name = "buildifier",
    include = [
        "*.bzl",
        "*.bazel",
        "BUILD",
        "WORKSPACE",
    ],
    check_args = ["-mode=check"],
    fix_args = ["-mode=fix"],
    tool = "@multitool//tools/buildifier",
    visibility = ["//visibility:public"],
)

formatter(
    name = "tombi",
    include = ["*.toml"],
    check_args = [
        "format",
        "--offline",
        "--check",
        "--diff",
    ],
    fix_args = [
        "format",
        "--offline",
    ],
    tool = "@multitool//tools/tombi",
    visibility = ["//visibility:public"],
)

formatter(
    name = "rumdl",
    include = ["*.md"],
    check_args = [
        "fmt",
        "--check",
    ],
    fix_args = ["fmt"],
    tool = "@multitool//tools/rumdl",
    visibility = ["//visibility:public"],
)

formatter(
    name = "ryl",
    include = [
        "*.yaml",
        "*.yml",
    ],
    check_args = [
        "format",
        "--check",
    ],
    fix_args = ["format"],
    tool = "@multitool//tools/ryl",
    visibility = ["//visibility:public"],
)
