load("//lint:defs.bzl", "gitleaks_history", "gitleaks_test", "shellcheck_test", "shfmt_test")
load("//lint/private:gitleaks_tool.bzl", "gitleaks_tool")
load("//repo:defs.bzl", "repo_files")
load("//testing:defs.bzl", "expect_failure_test")
load(":commit_identity_scenario.bzl", "commit_identity_scenario_test")
load(":cspell_tests.bzl", "cspell_test_suite")
load(":gitleaks_history_scenario.bzl", "gitleaks_history_scenario_test")
load(":gitleaks_private_scenario.bzl", "gitleaks_private_scenario_test")
load(":gitleaks_redact_scenario.bzl", "GITLEAKS_REDACT_FIXTURE", "gitleaks_redact_scenario_test")
load(":gitleaks_text_scenario.bzl", "gitleaks_text_scenario_test")
load(":tree_check_tests.bzl", "tree_check_test_suite")

repo_files()

tree_check_test_suite(name = "tree_check_tests")

cspell_test_suite(name = "cspell_tests")

# gitleaks_tool against throwaway trees, with and without the private
# config it requires.

gitleaks_tool(
    name = "gitleaks_required",
    required = True,
)

gitleaks_tool(name = "gitleaks_optional")

[
    gitleaks_private_scenario_test(
        name = "gitleaks_private_{}_test".format(scenario),
        patterns = patterns,
        scenario = scenario,
        status = status,
        subject = ":gitleaks_optional" if scenario == "optional" else ":gitleaks_required",
    )
    for scenario, status, patterns in [
        (
            "unset",
            1,
            ["gitleaks_tool: FAIL: GITLEAKS_CONFIG_TOML is unset or empty"],
        ),
        (
            "empty",
            1,
            ["gitleaks_tool: FAIL: GITLEAKS_CONFIG_TOML is unset or empty"],
        ),
        (
            "no_canary",
            1,
            ["has no rule with the id tbhb-private-canary"],
        ),
        (
            "other_config",
            1,
            ["the committed config is 'other.toml'"],
        ),
        (
            "no_committed",
            1,
            ["/.gitleaks.toml does not exist"],
        ),
        (
            "clean",
            0,
            ["no leaks found"],
        ),
        (
            "findings",
            1,
            [
                "RuleID: +aws-access-token",
                "RuleID: +tbhb-private-word",
                "RuleID: +tbhb-private-canary",
            ],
        ),
        (
            "optional",
            0,
            ["no leaks found"],
        ),
    ]
]

PROOF_TAGS = ["manual"]

# commit_identity against throwaway repositories.

[
    commit_identity_scenario_test(
        name = "commit_identity_" + scenario + "_test",
        scenario = scenario,
        subject = "//lint:commit_identity",
    )
    for scenario in [
        "allowed",
        "empty",
    ]
]

[
    commit_identity_scenario_test(
        name = "proof_commit_identity_" + scenario,
        scenario = scenario,
        subject = "//lint:commit_identity",
        tags = PROOF_TAGS,
    )
    for scenario in [
        "noreply_author",
        "wrong_committer",
    ]
]

# gitleaks_history against throwaway repositories.

gitleaks_history(
    name = "history_subject",
    tags = ["manual"],
)

gitleaks_history_scenario_test(
    name = "history_clean_test",
    scenario = "clean",
    subject = ":history_subject",
)

gitleaks_history_scenario_test(
    name = "history_no_content_test",
    scenario = "no_content",
    subject = ":history_subject",
)

# A key on another branch fails the default scan of every ref, and passes a
# scan limited to the checked-out branch.
gitleaks_history_scenario_test(
    name = "history_head_only_test",
    scenario = "other_branch",
    subject = ":history_subject",
    subject_args = ["--log-opts=HEAD"],
)

[
    gitleaks_history_scenario_test(
        name = "proof_history_" + scenario,
        scenario = scenario,
        subject = ":history_subject",
        tags = PROOF_TAGS,
    )
    for scenario in [
        "corrupt",
        "no_commits",
        "other_branch",
        "secret",
    ]
]

# The merge range excludes the base history but still catches keys removed
# before the merge. Full scans of the same base-secret fixture still fail.
gitleaks_history_scenario_test(
    name = "history_range_base_secret_test",
    scenario = "range_base_secret",
    subject = ":history_subject",
    subject_args = ["--merge-range"],
)

[
    gitleaks_history_scenario_test(
        name = "proof_history_" + scenario,
        expected_scan = announcement,
        scenario = scenario,
        subject = ":history_subject",
        subject_args = ["--merge-range"],
        tags = PROOF_TAGS,
    )
    for scenario, announcement in [
        ("range_secret", "gitleaks_history: scanning HEAD^1..HEAD (3 commits): the pull request's commits"),
        ("range_linear", "gitleaks_history: scanning full history HEAD (2 commits): HEAD does not have exactly two readable parents"),
        ("range_config", "gitleaks_history: scanning full history HEAD (5 commits): the pull request changes .gitleaks.toml"),
    ]
]

gitleaks_history_scenario_test(
    name = "proof_history_range_base_secret_full",
    scenario = "range_base_secret",
    subject = ":history_subject",
    subject_args = ["--log-opts=HEAD"],
    tags = PROOF_TAGS,
)

# gitleaks_text on piped text, with and without a committed config.

[
    gitleaks_text_scenario_test(
        name = "text_{}_test".format(scenario),
        scenario = scenario,
        subject = "//lint:gitleaks_text",
    )
    for scenario in [
        "clean",
        "clean_no_config",
    ]
]

gitleaks_text_scenario_test(
    name = "proof_text_secret",
    scenario = "secret",
    subject = "//lint:gitleaks_text",
    tags = PROOF_TAGS,
)

# Exercise the real tree macro and the history/text executables. The tree
# fixture is assembled by an action so no complete token is checked in.
genrule(
    name = "redact_fixture",
    testonly = True,
    outs = ["redact_creds.txt"],
    cmd = "(\n" + GITLEAKS_REDACT_FIXTURE + ") >$@",
    tags = ["manual"],
)

gitleaks_test(
    name = "redact_tree_subject",
    srcs = [":redact_fixture"],
    tags = ["manual"],
)

[
    gitleaks_redact_scenario_test(
        name = "{}_redact_test".format(scenario),
        scenario = scenario,
        subject = subject,
    )
    for scenario, subject in [
        ("history", ":history_subject"),
        ("text", "//lint:gitleaks_text"),
        ("tree", ":redact_tree_subject"),
    ]
]

# shellcheck_test and shfmt_test on a tree with no shell scripts: they pass
# with allow_empty and fail without it.

NO_SCRIPTS = ["testdata/root/a.txt"]

[
    rule(
        name = name + "_allow_empty_test",
        srcs = NO_SCRIPTS,
        allow_empty = True,
    )
    for name, rule in [
        ("shellcheck", shellcheck_test),
        ("shfmt", shfmt_test),
    ]
]

[
    rule(
        name = "proof_{}_empty".format(name),
        srcs = NO_SCRIPTS,
        tags = PROOF_TAGS,
    )
    for name, rule in [
        ("shellcheck", shellcheck_test),
        ("shfmt", shfmt_test),
    ]
]

PROOF_REASONS = {
    "proof_commit_identity_noreply_author": "commit_identity: FAIL: [0-9a-f]{40} author and committer are not an allowed pair: tbhb-agent <334376894\\+tbhb-agent@users.noreply.github.com> \\(author\\) -> tbhb.dev Agent <agent@tonyburns.net> \\(committer\\)",
    "proof_commit_identity_wrong_committer": "commit_identity: FAIL: [0-9a-f]{40} author and committer are not an allowed pair: tbhb.dev Agent <agent@tonyburns.net> \\(author\\) -> GitHub <noreply@github.com> \\(committer\\)",
    "proof_history_corrupt": "gitleaks_history: FAIL: git cannot read the history",
    "proof_history_no_commits": "gitleaks_history: FAIL: the repository has no commits",
    "proof_history_other_branch": "leaks found: [1-9]",
    "proof_history_range_base_secret_full": "leaks found: [1-9]",
    "proof_history_range_config": "leaks found: [1-9]",
    "proof_history_range_linear": "leaks found: [1-9]",
    "proof_history_range_secret": "leaks found: [1-9]",
    "proof_history_secret": "leaks found: [1-9]",
    "proof_shellcheck_empty": "shell_select: no shell scripts found, so nothing was checked",
    "proof_shfmt_empty": "shell_select: no shell scripts found, so nothing was checked",
    "proof_text_secret": "leaks found: [1-9]",
}

[
    expect_failure_test(
        name = proof + "_fails",
        pattern = pattern,
        test = ":" + proof,
    )
    for proof, pattern in PROOF_REASONS.items()
]
