load("//lint:defs.bzl", "gitleaks_history")
load("//repo:defs.bzl", "repo_files")
load("//testing:defs.bzl", "expect_failure_test")
load(":cspell_tests.bzl", "cspell_test_suite")
load(":gitleaks_history_scenario.bzl", "gitleaks_history_scenario_test")
load(":tree_check_tests.bzl", "tree_check_test_suite")

repo_files()

tree_check_test_suite(name = "tree_check_tests")

cspell_test_suite(name = "cspell_tests")

# gitleaks_history against throwaway repositories.

gitleaks_history(
    name = "history_subject",
    tags = ["manual"],
)

gitleaks_history_scenario_test(
    name = "history_clean_test",
    scenario = "clean",
    subject = ":history_subject",
)

gitleaks_history_scenario_test(
    name = "history_no_content_test",
    scenario = "no_content",
    subject = ":history_subject",
)

[
    gitleaks_history_scenario_test(
        name = "history_" + scenario,
        scenario = scenario,
        subject = ":history_subject",
        tags = ["manual"],
    )
    for scenario in [
        "corrupt",
        "no_commits",
        "secret",
    ]
]

expect_failure_test(
    name = "history_secret_fails",
    pattern = "leaks found: [1-9]",
    test = ":history_secret",
)

expect_failure_test(
    name = "history_no_commits_fails",
    pattern = "gitleaks_history: FAIL: the repository has no commits",
    test = ":history_no_commits",
)

expect_failure_test(
    name = "history_corrupt_fails",
    pattern = "gitleaks_history: FAIL: git cannot read the history",
    test = ":history_corrupt",
)
