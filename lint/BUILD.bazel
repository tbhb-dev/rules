load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//lint/private:commit_identity.bzl", "commit_identity")
load("//lint/private:gitleaks_text.bzl", "gitleaks_text")
load("//repo:defs.bzl", "repo_files")

repo_files()

# `common --//lint:gitleaks_private_config` (in a consumer's .bazelrc:
# `common --@tbhb_rules//lint:gitleaks_private_config`) makes gitleaks_test
# and gitleaks_history require the private gitleaks config in
# GITLEAKS_CONFIG_TOML and fail without it. See
# //lint/private:gitleaks_tool.bzl.
bool_flag(
    name = "gitleaks_private_config",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Scans stdin: `bazel run @tbhb_rules//lint:gitleaks_text < file`, from a
# consumer's workspace, under its .gitleaks.toml. repo-checks.yml runs it on
# a pull request's title and body.
gitleaks_text(
    name = "gitleaks_text",
    visibility = ["//visibility:public"],
)

# Checks the commits in a range against the allowed (author, committer)
# pairs: `bazel run @tbhb_rules//lint:commit_identity -- BASE HEAD`.
# repo-checks.yml runs it on a pull request's commits.
commit_identity(
    name = "commit_identity",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//lint/private:checks",
        "//lint/private:codeowners",
        "//lint/private:content",
        "//lint/private:cspell",
        "//lint/private:decision_records",
        "//lint/private:gitleaks_history",
        "//lint/private:gitleaks_tool",
        "//lint/private:mutation_oses",
        "//lint/private:okf_docs",
        "//lint/private:reuse",
        "//lint/private:shell",
        "//lint/private:tree_check",
        "//lint/private:vale",
    ],
)

# Resolve the binary through this module's tool repository mapping.
alias(
    name = "zizmor",
    actual = "@tbhb_rules_zizmor//:zizmor",
    visibility = ["//visibility:public"],
)
