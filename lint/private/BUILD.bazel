load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//repo:defs.bzl", "repo_files")

repo_files()

exports_files([
    "codeowners.sh",
    "gitleaks_history.sh.tpl",
    "shell_select.sh",
    "tree_check.sh.tpl",
    "vale.sh",
    "vale_sync.sh.tpl",
])

bzl_library(
    name = "tree_check",
    srcs = ["tree_check.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = ["@bazel_skylib//lib:shell"],
)

bzl_library(
    name = "checks",
    srcs = ["checks.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = [":tree_check"],
)

bzl_library(
    name = "codeowners",
    srcs = ["codeowners.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = [
        ":checks",
        ":tree_check",
    ],
)

bzl_library(
    name = "shell",
    srcs = ["shell.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = [":tree_check"],
)

bzl_library(
    name = "vale",
    srcs = ["vale.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = [
        ":tree_check",
        "@bazel_skylib//lib:shell",
    ],
)

bzl_library(
    name = "gitleaks_history",
    srcs = ["gitleaks_history.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = ["@bazel_skylib//lib:shell"],
)

bzl_library(
    name = "cspell",
    srcs = ["cspell.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = [":tree_check"],
)

exports_files(["okf_docs/check_docs.py"])

bzl_library(
    name = "okf_docs",
    srcs = ["okf_docs.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = [
        ":tree_check",
        "//runtime:defs",
    ],
)

bzl_library(
    name = "reuse",
    srcs = ["reuse.bzl"],
    visibility = ["//lint:__subpackages__"],
    deps = [
        ":tree_check",
        "//runtime:defs",
    ],
)
