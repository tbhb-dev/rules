config_setting(
    name = "gitleaks_private_required",
    flag_values = {"//lint:gitleaks_private_config": "True"},
    visibility = ["//visibility:public"],
)

# The default gitleaks of gitleaks_test and gitleaks_history.
gitleaks_tool(
    name = "gitleaks",
    required = select({
        ":gitleaks_private_required": True,
        "//conditions:default": False,
    }),
    visibility = ["//visibility:public"],
)

bzl_library(
