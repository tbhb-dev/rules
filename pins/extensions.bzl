"""The pinned tool binaries behind tbhb_rules' checks and formatters.

Every binary is a literal `http_archive` or `http_file` call, one per tool
and platform, so Renovate's bazel manager can move a version by rewriting
the URL and recomputing its sha256. Each tool also gets a hub repository,
`tbhb_rules_<tool>`, whose `//:<tool>` target picks the binary for the
target platform. Rules refer only to those hub labels.

A consumer replaces one tool with Bazel's `override_repo`:

    tools = use_extension("@tbhb_rules//pins:extensions.bzl", "tools")
    override_repo(tools, tbhb_rules_gitleaks = "my_gitleaks")

where `my_gitleaks` is any repository with a `//:gitleaks` target.
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive", "http_file")

_EXPORT = """exports_files(["{}"], visibility = ["//visibility:public"])"""

_PLATFORMS = {
    "linux_arm64": ["@platforms//os:linux", "@platforms//cpu:arm64"],
    "linux_x86_64": ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    "macos_arm64": ["@platforms//os:macos", "@platforms//cpu:arm64"],
}

def _tool_hub_impl(rctx):
    lines = [
        "# Generated by @tbhb_rules//pins:extensions.bzl.",
        "",
        "load(\"@tbhb_rules//pins:binary.bzl\", \"pinned_binary\")",
        "",
        "pinned_binary(",
        "    name = {},".format(repr(rctx.attr.tool)),
        "    tool = {},".format(repr(rctx.attr.tool)),
        "    binary = select({",
    ]
    for platform, label in sorted(rctx.attr.binaries.items()):
        lines.append("        {}: {},".format(repr(":" + platform), repr(label)))
    lines += [
        "    }, no_match_error = " + repr(
            "no pinned {} binary for this platform; the pins cover {}".format(
                rctx.attr.tool,
                ", ".join(sorted(rctx.attr.binaries)),
            ),
        ) + "),",
        "    visibility = [\"//visibility:public\"],",
        ")",
    ]
    for platform in sorted(rctx.attr.binaries):
        lines += [
            "",
            "config_setting(",
            "    name = {},".format(repr(platform)),
            "    constraint_values = {},".format(repr(_PLATFORMS[platform])),
            ")",
        ]
    rctx.file("BUILD.bazel", "\n".join(lines) + "\n")

_tool_hub = repository_rule(
    implementation = _tool_hub_impl,
    attrs = {
        "binaries": attr.string_dict(mandatory = True),
        "tool": attr.string(mandatory = True),
    },
)

