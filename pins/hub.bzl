"""The hub repository every pinned tool goes through, shared by tbhb_rules'
modules: one literal archive per tool and platform, and a `tbhb_rules_<tool>`
hub whose `//:<tool>` target picks the right one."""

EXPORT = """exports_files(["{}"], visibility = ["//visibility:public"])"""

# Git for Windows runs from its own tree, so the whole archive goes along.
EXPORT_TREE = EXPORT + """

filegroup(
    name = "tree",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)"""

PLATFORMS = {
    "linux_arm64": ["@platforms//os:linux", "@platforms//cpu:arm64"],
    "linux_x86_64": ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    "macos_arm64": ["@platforms//os:macos", "@platforms//cpu:arm64"],
    "windows_x86_64": ["@platforms//os:windows", "@platforms//cpu:x86_64"],
}

def _tool_hub_impl(rctx):
    lines = [
        "# Generated by @tbhb_rules//pins:extensions.bzl.",
        "",
        "load(\"@tbhb_rules//pins:binary.bzl\", \"pinned_binary\")",
        "",
        "pinned_binary(",
        "    name = {},".format(repr(rctx.attr.tool)),
        "    tool = {},".format(repr(rctx.attr.tool)),
        "    binary = select({",
    ]
    for platform, label in sorted(rctx.attr.binaries.items()):
        lines.append("        {}: {},".format(repr(":" + platform), repr(label)))
    lines.append(
        "    }, no_match_error = " + repr(
            "no pinned {} binary for this platform; the pins cover {}".format(
                rctx.attr.tool,
                ", ".join(sorted(rctx.attr.binaries)),
            ),
        ) + "),",
    )
    if rctx.attr.data:
        lines.append("    data = select({")
        for platform, label in sorted(rctx.attr.data.items()):
            lines.append("        {}: [{}],".format(repr(":" + platform), repr(label)))
        lines.append("        \"//conditions:default\": [],")
        lines.append("    }),")
    lines += [
        "    visibility = [\"//visibility:public\"],",
        ")",
    ]
    for platform in sorted(rctx.attr.binaries):
        lines += [
            "",
            "config_setting(",
            "    name = {},".format(repr(platform)),
            "    constraint_values = {},".format(repr(PLATFORMS[platform])),
            ")",
        ]
    rctx.file("BUILD.bazel", "\n".join(lines) + "\n")

tool_hub = repository_rule(
    implementation = _tool_hub_impl,
    doc = """A tool's hub: `//:<tool>` runs the binary pinned for the target platform.

Each module that pins tools makes one hub per tool in its own extension, so a
consumer replaces a tool with `override_repo` on that extension.""",
    attrs = {
        "binaries": attr.string_dict(mandatory = True),
        "data": attr.string_dict(doc = "Per platform, a label of files the binary needs beside it."),
        "tool": attr.string(mandatory = True),
    },
)
