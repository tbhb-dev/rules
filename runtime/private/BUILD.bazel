load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//repo:defs.bzl", "repo_files")
load(":python_mismatch_tests.bzl", "python_mismatch_test_suite")
load(":python_sync_tests.bzl", "python_sync_test_suite")

repo_files()

exports_files([
    "launch.py",
    "launch.sh.tpl",
    "lock_info.py",
])

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
    visibility = ["//runtime:__subpackages__"],
)

bzl_library(
    name = "repo",
    srcs = ["repo.bzl"],
    visibility = ["//runtime:__subpackages__"],
    deps = [
        ":python_mismatch",
        ":versions",
    ],
)

bzl_library(
    name = "python_mismatch",
    srcs = ["python_mismatch.bzl"],
    visibility = ["//runtime:__subpackages__"],
)

python_mismatch_test_suite(name = "python_mismatch_tests")

python_sync_test_suite(name = "python_sync_tests")

bzl_library(
    name = "env_info",
    srcs = ["env_info.bzl"],
    visibility = ["//runtime:__subpackages__"],
)

bzl_library(
    name = "env",
    srcs = ["env.bzl"],
    visibility = ["//runtime:__subpackages__"],
    deps = [
        ":env_info",
        "@bazel_skylib//lib:shell",
    ],
)
