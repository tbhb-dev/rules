load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//repo:defs.bzl", "repo_files")

repo_files()

exports_files([
    "launch.py",
    "launch.sh.tpl",
    "lock_info.py",
])

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
    visibility = ["//runtime:__subpackages__"],
)

bzl_library(
    name = "repo",
    srcs = ["repo.bzl"],
    visibility = ["//runtime:__subpackages__"],
    deps = [":versions"],
)

bzl_library(
    name = "env_info",
    srcs = ["env_info.bzl"],
    visibility = ["//runtime:__subpackages__"],
)

bzl_library(
    name = "env",
    srcs = ["env.bzl"],
    visibility = ["//runtime:__subpackages__"],
    deps = [
        ":env_info",
        "@bazel_skylib//lib:shell",
    ],
)
