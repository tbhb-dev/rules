{
  "language": "en",
  "ignorePaths": [
    ".mise/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    ".venv/**/*",
    ".bazel-*/**/*",
    "bazel-*/**/*",
    "lint/gitleaks/base.toml",
    "lint/gitleaks/upstream.toml",
    "coverage.xml",
    "go.sum",
    "LICENSE",
    "MODULE.bazel.lock",
    "mise.lock",
    "tmp/**/*",
    "**/testdata/**/*",
    "**/*.d2.svg",
    "**/*.d2.sha256",
    "**/pnpm-lock.yaml",
    "preset.bazelrc",
    "uv.lock"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project", "golang", "python"]
}
