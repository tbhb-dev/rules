load("@rules_apple//apple:ios.bzl", "ios_application", "ios_unit_test")
load("@rules_apple//apple:macos.bzl", "macos_application", "macos_unit_test")
load("@rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

swift_library(
    name = "Greeting",
    srcs = ["Sources/Greeting/Greeting.swift"],
    module_name = "Greeting",
)

swift_test(
    name = "Greeting_test",
    srcs = ["Tests/Greeting/GreetingTests.swift"],
    deps = [":Greeting"],
)

# iOS: the simulator only; no signing, provisioning or certificates.
swift_library(
    name = "ios_app_lib",
    srcs = ["iOS/SmokeApp.swift"],
    module_name = "SmokeIOSApp",
    deps = [":Greeting"],
)

ios_application(
    name = "ios_app",
    bundle_id = "dev.tbhb.smoke.ios",
    families = ["iphone"],
    infoplists = ["iOS/Info.plist"],
    minimum_os_version = "17.0",
    deps = [":ios_app_lib"],
)

ios_xctestrun_runner(
    name = "ios_simulator",
    device_type = "iPhone 17",
    os_version = "27.2",
)

swift_library(
    name = "ios_tests_lib",
    testonly = True,
    srcs = ["iOS/Tests/SmokeAppTests.swift"],
    module_name = "SmokeIOSAppTests",
    deps = [":Greeting"],
)

ios_unit_test(
    name = "ios_app_test",
    minimum_os_version = "17.0",
    runner = ":ios_simulator",
    test_host = ":ios_app",
    deps = [":ios_tests_lib"],
)

macos_application(
    name = "macos_app",
    bundle_id = "dev.tbhb.smoke.macos",
    infoplists = ["macOS/Info.plist"],
    minimum_os_version = "14.0",
    deps = [":macos_app_lib"],
)

swift_library(
    name = "macos_app_lib",
    srcs = ["macOS/SmokeApp.swift"],
    module_name = "SmokeMacApp",
    deps = [":Greeting"],
)

swift_library(
    name = "macos_tests_lib",
    testonly = True,
    srcs = ["macOS/Tests/SmokeAppTests.swift"],
    module_name = "SmokeMacAppTests",
    deps = [":Greeting"],
)

macos_unit_test(
    name = "macos_app_test",
    minimum_os_version = "14.0",
    test_host = ":macos_app",
    deps = [":macos_tests_lib"],
)

SWIFT_SOURCES = glob(["**/*.swift"])

# SwiftLint, from the binary the module pins. It reads the Swift sources and
# its config from the runfiles tree.
sh_test(
    name = "swiftlint_test",
    srcs = ["tools/swiftlint_test.sh"],
    args = ["$(rootpath @swiftlint)"],
    data = SWIFT_SOURCES + [
        ".swiftlint.yml",
        "@swiftlint",
    ],
)

# swift-format has no hermetic source (see README.md), so this fails on
# purpose. It is manual so `//...` skips it; run it by name.
sh_test(
    name = "swift_format_test",
    srcs = ["tools/swift_format_unavailable.sh"],
    data = SWIFT_SOURCES + [".swift-format"],
    tags = ["manual"],
)
