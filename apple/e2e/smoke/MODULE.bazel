"""Smoke consumer for Swift and Apple builds under Bazel 9.

A Swift library, an iOS app (simulator) and a macOS app, each with a unit
test, plus SwiftLint and swift-format over the sources. It uses no signing,
provisioning or certificates. Xcode comes from the host, through
apple_support's Xcode config; nothing else does.
"""

module(name = "tbhb_rules_apple_smoke")

bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# SwiftLint's release binary (a universal macOS executable), pinned by sha256
# so Bazel fetches it and no PATH or Homebrew copy is involved.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "swiftlint",
    build_file_content = 'exports_files(["swiftlint"])',
    sha256 = "c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0",
    url = "https://github.com/realm/SwiftLint/releases/download/0.65.1/portable_swiftlint.zip",
)
