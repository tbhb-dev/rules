load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load(":golangci_fmt.bzl", "golangci_fmt_tool")

repo_files()

# go-arch-lint for this platform (MODULE.bazel pins one archive each).
alias(
    name = "go_arch_lint",
    actual = select({
        ":darwin_arm64": "@go_arch_lint_darwin_arm64//:go-arch-lint",
        ":linux_amd64": "@go_arch_lint_linux_amd64//:go-arch-lint",
        ":linux_arm64": "@go_arch_lint_linux_arm64//:go-arch-lint",
    }),
    visibility = ["//visibility:public"],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

# The tool behind //:golangci_fmt.
golangci_fmt_tool(
    name = "golangci_fmt_tool",
    visibility = ["//:__pkg__"],
)

exports_files(
    [
        "deadcode.sh",
        "go_arch_lint.sh.tpl",
        "golangci_lint.sh",
        "golangci_lint_merge.sh",
        "go_mod_tidy.sh.tpl",
        "golangci_lint_test.sh.tpl",
        "report_test.sh.tpl",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "golangci_lint",
    srcs = ["golangci_lint.bzl"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@bazel_skylib//rules:common_settings",
        "@rules_go//go:def",
    ],
)

bzl_library(
    name = "deadcode",
    srcs = ["deadcode.bzl"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":golangci_lint",
        "@rules_go//go:def",
    ],
)

bzl_library(
    name = "go_mod_tidy",
    srcs = ["go_mod_tidy.bzl"],
    visibility = ["//:__subpackages__"],
    deps = ["@bazel_skylib//lib:shell"],
)

bzl_library(
    name = "go_mod_proxy",
    srcs = ["go_mod_proxy.bzl"],
    visibility = ["//:__subpackages__"],
)

bzl_library(
    name = "golangci_fmt",
    srcs = ["golangci_fmt.bzl"],
    visibility = ["//:__subpackages__"],
)

bzl_library(
    name = "go_srcs",
    srcs = ["go_srcs.bzl"],
    visibility = ["//:__subpackages__"],
    deps = ["@rules_go//go:def"],
)

bzl_library(
    name = "go_arch_lint",
    srcs = ["go_arch_lint.bzl"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":go_srcs",
        "@bazel_skylib//lib:shell",
    ],
)
