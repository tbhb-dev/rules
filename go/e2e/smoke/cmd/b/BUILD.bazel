load("@rules_go//go:def.bzl", "go_binary")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

# pure = "on" builds this binary's dependencies in another configuration
# than cmd/a's, so the shared package is analyzed (and linted) twice.
go_binary(
    name = "b",
    srcs = ["main.go"],
    pure = "on",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/feature2",
        "//internal/shared",
        "//lib",
    ],
)

go_binary(
    name = "b_planted",
    srcs = ["main.go"],
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//internal/feature2",
        "//internal/shared:planted_dead",
        "//lib",
    ],
)
