load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

# pure = "on" builds this binary's dependencies in another configuration
# than cmd/a's, so the shared package is analyzed (and linted) twice.
go_binary(
    name = "b",
    embed = [":b_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "b_planted",
    srcs = ["main.go"],
    pure = "on",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//internal/feature2",
        "//internal/shared:planted_dead",
        "//lib",
    ],
)

go_library(
    name = "b_lib",
    srcs = ["main.go"],
    importpath = "example.com/smoke/cmd/b",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/feature2",
        "//internal/shared",
        "//lib",
    ],
)
