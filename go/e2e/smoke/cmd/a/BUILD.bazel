load("@rules_go//go:def.bzl", "go_binary")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_binary(
    name = "a",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
    deps = [
        "//internal/feature1",
        "//internal/shared",
    ],
)

# The same binary over the shared package with its planted defects.
go_binary(
    name = "a_planted",
    srcs = ["main.go"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//internal/feature1",
        "//internal/shared:planted_dead",
    ],
)
