"""Consumes tbhb_rules_go the way a Go repository would.

A small module with two binaries sharing a package (one built pure, a second
configuration), layered internal packages and one external dependency
(go-cmp, through go_deps), under golangci-lint, deadcode, go-arch-lint,
go mod tidy, gomutants, gobco, govulncheck and the golangci-lint formatter; a
parity check of the aspect against golangci-lint run the ordinary way; and
proofs that the checks fail on planted defects. govulncheck/ is a second
module, at a vulnerable version of golang.org/x/text, for the govulncheck
proofs.
"""

module(name = "tbhb_rules_go_smoke")

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "../../..",
)

bazel_dep(name = "tbhb_rules_go")
local_path_override(
    module_name = "tbhb_rules_go",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

# A Go repository registers the hermetic C/C++ toolchain itself:
# hermetic_cc_toolchain makes its repositories only for the root module.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    go_mod = "//:go.mod",
    sdks = {
        "darwin_amd64": [
            "go1.27.3.darwin-amd64.tar.gz",
            "b6f8e931e4ab497fcde6da8ae4499a58f9d258e55c8a80824a516eae5950a750",
        ],
        "darwin_arm64": [
            "go1.27.3.darwin-arm64.tar.gz",
            "dd3908cf20959d798c1e06ebe5b72213f0505ce01373b40ce3110975a6cd99c2",
        ],
        "linux_amd64": [
            "go1.27.3.linux-amd64.tar.gz",
            "65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40",
        ],
        "linux_arm64": [
            "go1.27.3.linux-arm64.tar.gz",
            "a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49",
        ],
        "windows_amd64": [
            "go1.27.3.windows-amd64.zip",
            "f26081f438319757f8a1b46d7d0b2c5ec7583d4038e485e0aa725cfde7885fff",
        ],
        "windows_arm64": [
            "go1.27.3.windows-arm64.zip",
            "c507872ff21f8a7cd3c1c217b059c6f7271a4a9d8e692810ef9dd3e1f601197c",
        ],
    },
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# govulncheck/ is a module of its own, at a vulnerable version of x/text. A
# go_deps extension reads one go.mod, so the version is pinned here as well.
go_deps.module(
    path = "golang.org/x/text",
    sum = "h1:aRYxNxv6iGQlyVaZmk6ZgYEDa+Jg18DxebPSrd6bg1M=",
    version = "v0.3.6",
)
use_repo(go_deps, "com_github_google_go_cmp", "org_golang_x_text")

# The modules go.sum lists, as a GOPROXY directory, for go_mod_tidy_test,
# the parity oracle and govulncheck_test; and the same for govulncheck/.
go_mod_proxy = use_extension("@tbhb_rules_go//:extensions.bzl", "go_mod_proxy")
go_mod_proxy.from_file(
    name = "go_mod_proxy",
    go_sum = "//:go.sum",
)
go_mod_proxy.from_file(
    name = "vulnerable_proxy",
    go_sum = "//govulncheck:go.sum",
)
use_repo(go_mod_proxy, "go_mod_proxy", "vulnerable_proxy")
