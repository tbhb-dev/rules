# The root BUILD.bazel is the README's quickstart verbatim, so it cannot
# export MODULE.bazel and BUILD.bazel to //readme; a public default does.
repo(default_visibility = ["//visibility:public"])

# Bazel's convenience symlinks hold no source; ignoring them keeps them out
# of every glob, so //:repo_files never follows them into the output tree.
ignore_directories(["bazel-*"])
