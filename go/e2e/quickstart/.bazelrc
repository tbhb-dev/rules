# The quickstart's git_overrides name a placeholder commit; these flags take
# precedence and use this checkout instead.
common --override_module=tbhb_rules=../../..
common --override_module=tbhb_rules_go=../..

# Both modules come from this checkout, so the lockfile would churn with
# every change there; it is not committed.
common --lockfile_mode=off
