load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("@tbhb_rules//testing:defs.bzl", "expect_failure_test")
load("//:defs.bzl", "go_deadcode_test")

repo_files()

FIXTURE = "//tests/deadcode/fixture"

# Everything is reached: lib.Used by the binary, lib.OnlyTests by the test.
go_deadcode_test(
    name = "clean_test",
    srcs = [
        FIXTURE + "/app",
        FIXTURE + "/lib:lib_test",
    ],
)

# Proofs. Each wrapped test is manual and must fail for the stated reason.
PROOF_TAGS = ["manual"]

# dead.Dead is reached by nothing.
go_deadcode_test(
    name = "proof_dead_function",
    srcs = [FIXTURE + "/deadapp"],
    tags = PROOF_TAGS,
)

# Without the test, lib.OnlyTests is dead: the test main is what reaches it.
go_deadcode_test(
    name = "proof_without_tests",
    srcs = [FIXTURE + "/app"],
    tags = PROOF_TAGS,
)

PROOF_REASONS = {
    "proof_dead_function": "tests/deadcode/fixture/dead/dead.go:[0-9]+:[0-9]+: unreachable func: Dead",
    "proof_without_tests": "unreachable func: OnlyTests",
}

[
    expect_failure_test(
        name = proof + "_fails",
        pattern = pattern,
        test = ":" + proof,
    )
    for proof, pattern in PROOF_REASONS.items()
]
