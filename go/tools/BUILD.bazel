load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

exports_files(
    glob(["*.go"]),
    visibility = ["//tests:__subpackages__"],
)

go_library(
    name = "tools_lib",
    srcs = ["main.go"],
    importpath = "github.com/tbhb-dev/rules/go/tools",
    visibility = ["//visibility:private"],
    deps = ["//tools/sdkchecksums"],
)

go_binary(
    name = "go_sdk_checksums",
    embed = [":tools_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "tools_test",
    srcs = ["main_test.go"],
    data = ["//tools/sdkchecksums:testdata/releases.json"],
    embed = [":tools_lib"],
    visibility = ["//tests:__subpackages__"],
    deps = ["//tools/sdkchecksums"],
)
