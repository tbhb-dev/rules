load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

exports_files(
    glob(["*.go"]),
    visibility = ["//tests:__subpackages__"],
)

exports_files(
    ["testdata/releases.json"],
    visibility = ["//tools:__pkg__"],
)

go_library(
    name = "sdkchecksums",
    srcs = ["checksums.go"],
    importpath = "github.com/tbhb-dev/rules/go/tools/sdkchecksums",
    visibility = [
        "//tests:__subpackages__",
        "//tools:__pkg__",
    ],
    deps = ["@com_github_bazelbuild_buildtools//build"],
)

go_test(
    name = "sdkchecksums_test",
    srcs = ["checksums_test.go"],
    data = ["testdata/releases.json"],
    embed = [":sdkchecksums"],
    visibility = ["//tests:__subpackages__"],
)
