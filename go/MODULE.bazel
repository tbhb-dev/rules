"""Go rules for tbhb-dev repositories: golangci-lint, deadcode, go mod tidy
and a golangci-lint formatter.

Consumers load only `@tbhb_rules_go//:defs.bzl`. See README.md.
"""

module(
    name = "tbhb_rules_go",
    version = "0.0.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")

# Default tool pins. Like tbhb_rules', they join rules_multitool's default
# `multitool` hub, so a consumer can override any pin with its own lockfile.
multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

# Go tools without a prebuilt release (deadcode) are built by rules_go from
# the `tool` directives in go.mod. A consumer that also uses go_deps shares
# the module graph, and its versions win by minimal version selection.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "org_golang_x_tools")

# Dev dependencies: this module's own tests.
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

# Module proxies for go_mod_tidy_test: the fixtures' (the tampered go.sum
# lists the same modules) and this module's own.
go_mod_proxy = use_extension("//:extensions.bzl", "go_mod_proxy", dev_dependency = True)
go_mod_proxy.from_file(
    name = "gomod_fixture_proxy",
    go_sum = "//tests/gomod/tidy:go.sum",
)
go_mod_proxy.from_file(
    name = "self_go_mod_proxy",
    go_sum = "//:go.sum",
)
use_repo(go_mod_proxy, "gomod_fixture_proxy", "self_go_mod_proxy")

# The Go SDK the tests build with; consumers bring their own. Matches the
# toolchain directive in tbhb-dev's Go modules.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.27.3")
