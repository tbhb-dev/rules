    data = [
        "//:.github/actions/setup-bazel-ci/action.yml",
        "//:.github/actions/setup-bazel-ci/fetch-targets.txt",
        "//:.github/workflows/ci.yml",
        "//:.github/workflows/pr-text.yml",
        "//:.github/workflows/repo-checks.yml",
        "//:BUILD.bazel",
    ],
    env = {"ROOT_RLOCATIONPATH": "$(rlocationpath //:BUILD.bazel)"},
)

sh_test(
    name = "cache_fetch_test",
    srcs = ["cache_fetch_test.sh"],
    data = [
        "//:.github/actions/setup-bazel-ci/fetch.sh",
        "//:.github/actions/setup-bazel-ci/fetch-targets.txt",
    ],
    env = {"SCRIPT_RLOCATIONPATH": "$(rlocationpath //:.github/actions/setup-bazel-ci/fetch.sh)"},
