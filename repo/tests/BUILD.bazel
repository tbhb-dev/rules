load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//repo:defs.bzl", "repo_files")
load("//testing:defs.bzl", "expect_failure_test")
load(":repo_layout_tests.bzl", "repo_layout_test_suite", "required_files_layout_test", "scripts_layout_test")

repo_files()

repo_layout_test_suite(name = "repo_layout_tests")

scripts_layout_test(
    name = "good_test",
    fixture = "good",
)

PROOF_TAGS = ["manual"]

# Each fixture breaks one rule; each proof names the problem it must report.
PROOF_REASONS = {
    "proof_extension": "^tools/check\\.py: tools/ scripts carry no file extension$",
    "proof_metadata": "^tools/check-other: must declare inline script metadata",
    "proof_shebang": "^tools/check-other: must start with '#!/usr/bin/env -S uv run --script'$",
    "proof_subdir": "^tools/extra/thing\\.py: tools/ holds no subdirectory extra/$",
    "proof_unknown_top": "^scratch/: top-level directory is not in the layout$",
}

[
    scripts_layout_test(
        name = proof,
        fixture = proof.removeprefix("proof_"),
        tags = PROOF_TAGS,
    )
    for proof in PROOF_REASONS
]

[
    expect_failure_test(
        name = proof + "_fails",
        pattern = pattern,
        test = ":" + proof,
    )
    for proof, pattern in PROOF_REASONS.items()
]

scripts_layout_test(
    name = "proof_no_files",
    fixture = "",
    tags = PROOF_TAGS,
)

expect_failure_test(
    name = "proof_no_files_fails",
    pattern = "repo_layout: FAIL: no files to check",
    test = ":proof_no_files",
)

REQUIRED_FILES = {"templates": [
    "TEMPLATE.md",
    "WRITING.md",
    "REVIEW.md",
]}

required_files_layout_test(
    name = "required_files_test",
    fixture = "required_good",
    required_files = REQUIRED_FILES | {
        "docs/templates": ["TEMPLATE.md"],
        "templates/alpha/nested": ["UNUSED.md"],
    },
)

required_files_layout_test(
    name = "required_files_empty_list_test",
    fixture = "required_good",
    required_files = {"templates": []},
)

required_files_layout_test(
    name = "proof_required_file",
    fixture = "required_missing_file",
    required_files = REQUIRED_FILES,
    tags = PROOF_TAGS,
)

expect_failure_test(
    name = "proof_required_file_fails",
    pattern = "^templates/alpha/: missing required file REVIEW\\.md$",
    test = ":proof_required_file",
)

required_files_layout_test(
    name = "proof_required_directory",
    fixture = "required_missing_directory",
    required_files = REQUIRED_FILES,
    tags = PROOF_TAGS,
)

expect_failure_test(
    name = "proof_required_directory_fails",
    pattern = "^templates/: required_files directory does not exist in srcs$",
    test = ":proof_required_directory",
)

required_files_layout_test(
    name = "proof_required_directory_empty_list",
    fixture = "required_missing_directory",
    required_files = {"templates": []},
    tags = PROOF_TAGS,
)

expect_failure_test(
    name = "proof_required_directory_empty_list_fails",
    pattern = "^templates/: required_files directory does not exist in srcs$",
    test = ":proof_required_directory_empty_list",
)

required_files_layout_test(
    name = "proof_required_two_files",
    fixture = "required_missing_two_files",
    required_files = REQUIRED_FILES,
    tags = PROOF_TAGS,
)

# Both diagnostics must appear, even though they belong to one directory.
[
    expect_failure_test(
        name = "proof_required_two_files_" + file.lower() + "_fails",
        pattern = "^templates/alpha/: missing required file " + file + "\\.md$",
        test = ":proof_required_two_files",
    )
    for file in [
        "WRITING",
        "REVIEW",
    ]
]

# The source archive keeps the composite actions that consumers call by
# commit. Windows has no wrapped Git to run.
sh_test(
    name = "archive_actions_test",
    srcs = ["archive_actions_test.sh"],
    data = [
        "//:.gitattributes",
        "@tbhb_rules_git//:git",
    ],
    env = {
        "GITATTRIBUTES_RLOCATIONPATH": "$(rlocationpath //:.gitattributes)",
        "GIT_RLOCATIONPATH": "$(rlocationpath @tbhb_rules_git//:git)",
    },
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

# The retries in repo-checks.yml must give up before the job's timeout.
sh_test(
    name = "retry_budget_test",
    srcs = ["retry_budget_test.sh"],
    data = ["//:.github/workflows/repo-checks.yml"],
    env = {"WORKFLOW_RLOCATIONPATH": "$(rlocationpath //:.github/workflows/repo-checks.yml)"},
)

# setup-bazel-ci's CPU quota script, against fake cgroup files. The cases
# that expect a count need a host with more than 2 CPUs.
sh_test(
    name = "cpu_quota_test",
    srcs = ["cpu_quota_test.sh"],
    data = ["//:.github/actions/setup-bazel-ci/cpu_quota.sh"],
    env = {"SCRIPT_RLOCATIONPATH": "$(rlocationpath //:.github/actions/setup-bazel-ci/cpu_quota.sh)"},
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

# Keep readers and the sole writer in the same complete cache family.
sh_test(
    name = "cache_contract_test",
    srcs = ["cache_contract_test.sh"],
    data = [
        "//:.github/actions/setup-bazel-ci/action.yml",
        "//:.github/actions/setup-bazel-ci/fetch-targets.txt",
        "//:.github/workflows/ci.yml",
        "//:.github/workflows/pr-text.yml",
        "//:.github/workflows/repo-checks.yml",
        "//:BUILD.bazel",
    ],
    env = {"ROOT_RLOCATIONPATH": "$(rlocationpath //:BUILD.bazel)"},
)

sh_test(
    name = "cache_fetch_test",
    srcs = ["cache_fetch_test.sh"],
    data = [
        "//:.github/actions/setup-bazel-ci/fetch.sh",
        "//:.github/actions/setup-bazel-ci/fetch-targets.txt",
    ],
    env = {"SCRIPT_RLOCATIONPATH": "$(rlocationpath //:.github/actions/setup-bazel-ci/fetch.sh)"},
)
