# Git supplies the complete source list, including the nested Bazel modules.
sh_test(
    name = "mktemp_test",
    srcs = ["mktemp_test.sh"],
    data = ["@tbhb_rules_git//:git"],
    env = {"GIT_RLOCATIONPATH": "$(rlocationpath @tbhb_rules_git//:git)"},
    tags = [
        "local",
        "no-cache",
    ],
)

sh_test(
    name = "mktemp_clean_test",
    srcs = ["mktemp_test.sh"],
    data = ["testdata/mktemp/clean.sh"],
    env = {"FIXTURE_RLOCATIONPATH": "$(rlocationpath testdata/mktemp/clean.sh)"},
)

sh_test(
    name = "proof_mktemp",
    srcs = ["mktemp_test.sh"],
    data = ["testdata/mktemp/bad.sh"],
    env = {"FIXTURE_RLOCATIONPATH": "$(rlocationpath testdata/mktemp/bad.sh)"},
    tags = ["manual"],
)

[
    expect_failure_test(
        name = "mktemp_line_{}_fails_test".format(line),
        pattern = "bad\\.sh:{}: bare mktemp: use mktemp".format(line),
        test = ":proof_mktemp",
    )
    for line in range(4, 8)
]

# The key names of mise.toml must equal the baseline's. The script runs as a
# test through the locked Python environment.
python_tool(
    name = "check_mise_keys",
    testonly = True,
    main = "check_mise_keys.py",
    python_env = "@tbhb_rules_python_runtime//:env",
    tags = ["manual"],
)

# On Windows `python_tool` is a .bat, and `sh_test` fails analysis unless the
# test name carries the source's extension. `pytest_test` covers the check's
# logic there.
MISE_KEYS_NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

MISE_KEYS_CLEAN = [
    "repo/tests/testdata/mise_keys/clean/baseline.toml",
    "repo/tests/testdata/mise_keys/clean/mise.toml",
]

MISE_KEYS_BAD = [
    "repo/tests/testdata/mise_keys/bad/baseline.toml",
    "repo/tests/testdata/mise_keys/bad/mise.toml",
]

sh_test(
    name = "mise_keys_test",
    srcs = [":check_mise_keys"],
    args = [
        "repo/baseline/files/mise.toml.baseline",
        "mise.toml",
    ],
    data = [
        "//:mise.toml",
        "//repo/baseline:repo_files",
    ],
    target_compatible_with = MISE_KEYS_NOT_WINDOWS,
)

sh_test(
    name = "mise_keys_clean_test",
    srcs = [":check_mise_keys"],
    args = MISE_KEYS_CLEAN,
    data = glob(["testdata/mise_keys/clean/*"]),
    target_compatible_with = MISE_KEYS_NOT_WINDOWS,
)

sh_test(
    name = "proof_mise_keys",
    srcs = [":check_mise_keys"],
    args = MISE_KEYS_BAD,
    data = glob(["testdata/mise_keys/bad/*"]),
    tags = ["manual"],
    target_compatible_with = MISE_KEYS_NOT_WINDOWS,
)

[
    expect_failure_test(
        name = "proof_mise_keys_" + name + "_fails",
        args = MISE_KEYS_BAD,
        pattern = pattern,
        test = ":proof_mise_keys",
    )
    for name, pattern in {
        "absent": "tools.bazelisk is in the baseline .* but missing here",
        "extra": "settings.extra_setting is not in the baseline",
    }.items()
]

# Every consumer repository must have the files its kind requires. The
# fixtures carry a small manifest of their own; the real baseline is not run
# against this repository, which fits no kind.
python_tool(
    name = "check_required_files",
    testonly = True,
    main = "check_required_files.py",
    python_env = "@tbhb_rules_python_runtime//:env",
    tags = ["manual"],
)

REQUIRED_FILES_DATA = [
    "//repo/baseline:repo_files",
] + glob(["testdata/required_files/**"])

REQUIRED_FILES_ROOT = "repo/tests/testdata/required_files/"

REQUIRED_FILES_ARGS = [
    REQUIRED_FILES_ROOT + "manifest.toml",
    "repo/baseline/repo.schema.json",
]

[
    sh_test(
        name = "required_files_{}_test".format(case),
        srcs = [":check_required_files"],
        args = REQUIRED_FILES_ARGS + [REQUIRED_FILES_ROOT + "clean/" + case],
        data = REQUIRED_FILES_DATA,
        target_compatible_with = MISE_KEYS_NOT_WINDOWS,
    )
    for case in [
        "go",
        "docs",
    ]
]

# Each bad fixture breaks one rule; each proof pins exit status 1 and the exact
# first line the check prints. Output after the first line is not checked.
REQUIRED_FILES_PROOFS = {
    "bad_exception": "^[^ ]+/\\.tbhb-repo\\.toml: exception for go\\.mod but it is not missing$",
    "missing_dir": "^[^ ]+: required directory cmd/ is missing$",
    "missing_file": "^[^ ]+: required file go\\.mod is missing$",
    "private_license": "^[^ ]+: required file LICENSES/LicenseRef-Proprietary\\.txt is missing$",
    "unknown_kind": "^[^ ]+/\\.tbhb-repo\\.toml: \\$\\.kind: 'rust' is not one of \\['go', 'python', 'docs', 'chezmoi'\\]$",
}

[
    sh_test(
        name = "proof_required_files_" + case,
        srcs = [":check_required_files"],
        args = REQUIRED_FILES_ARGS + [REQUIRED_FILES_ROOT + "bad/" + case],
        data = REQUIRED_FILES_DATA,
        tags = ["manual"],
        target_compatible_with = MISE_KEYS_NOT_WINDOWS,
    )
    for case in REQUIRED_FILES_PROOFS
]

[
    expect_failure_test(
        name = "proof_required_files_{}_fails".format(case),
        args = REQUIRED_FILES_ARGS + [REQUIRED_FILES_ROOT + "bad/" + case],
        exit_status = 1,
        first_line = True,
        pattern = pattern,
        test = ":proof_required_files_" + case,
    )
    for case, pattern in REQUIRED_FILES_PROOFS.items()
]

pytest_test(
    name = "pytest_test",
    srcs = ["//:repo_files"],
    args = ["repo/tests"],
    coverage = ["repo/tests"],
    visibility = ["//:__pkg__"],
)
