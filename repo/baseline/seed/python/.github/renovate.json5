{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#{{renovate_config_sha}}", // main
    "github>tbhb-dev/renovate-config//bazel.json5#{{renovate_config_sha}}", // main
    "github>tbhb-dev/renovate-config//python.json5#{{renovate_config_sha}}", // main
  ],

  // {{repo_name}}: one Bazel module and one uv project, no Go, so no go.json5.
  // Nothing local is needed beyond the presets.
}
