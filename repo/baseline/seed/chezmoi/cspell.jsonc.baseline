{
  "language": "en",
  "ignorePaths": [
    "home/**/*",
    ".mise/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    ".venv/**/*",
    "bazel-*/**/*",
    ".bazel-*/**/*",
    "coverage.xml",
    "MODULE.bazel.lock",
    "mise.lock",
    "tmp/**/*",
    "uv.lock"
  ],
  "dictionaryDefinitions": [
    {
      "name": "{{repo_name}}",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["{{repo_name}}", "python"]
}
