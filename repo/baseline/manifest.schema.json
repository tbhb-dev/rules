{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository baseline manifest, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kinds",
    "placeholders",
    "never_write",
    "file",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "never_write": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "file": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
            "minLength": 1
          },
          "source": {
            "description": "Stored filename, independent of the consumer path; avoid live tool configuration names.",
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "bytes",
              "keys",
              "lines",
              "seed"
            ]
          },
          "visibility": {
            "enum": [
              "all",
              "public",
              "private"
            ],
            "default": "all"
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^.]+(?:\\.[^.]+)*$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "template": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "keys"
                }
              }
            },
            "then": {
              "required": [
                "keys"
              ],
              "properties": {
                "source": {
                  "pattern": "\\.(?:toml|ya?ml|json)(?:\\.baseline)?$"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "keys"
                ]
              }
            }
          }
        ]
      }
    },
    "kind": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "hooks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pre-commit",
              "commit-msg",
              "pre-push"
            ],
            "properties": {
              "pre-commit": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "commit-msg": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "pre-push": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "hooks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pre-commit",
                "commit-msg",
                "pre-push"
              ],
              "properties": {
                "pre-commit": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "commit-msg": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "pre-push": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "private": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "hooks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pre-commit",
                "commit-msg",
                "pre-push"
              ],
              "properties": {
                "pre-commit": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "commit-msg": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "pre-push": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  }
}
