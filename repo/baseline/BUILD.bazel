load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//runtime:defs.bzl", "python_tool")

filegroup(
    name = "repo_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

python_tool(
    name = "drift_tool",
    main = "baseline_drift.py",
    python_env = "@tbhb_rules_python_runtime//:env",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Keep the consumer package loadable without the maintainer's Python module.
test_suite(
    name = "manifest_test",
    tests = ["//repo/tests:baseline_manifest_test"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "baseline_sync",
    srcs = ["//repo/private:baseline_drift.sh"],
    args = [
        "$(rootpath :drift_tool)",
        "sync",
    ],
    data = [
        ":drift_tool",
        ":repo_files",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
