{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer repository declaration, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "private"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "go",
        "python",
        "docs",
        "chezmoi"
      ]
    },
    "private": {
      "type": "boolean"
    },
    "exception": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "path",
          "reason"
        ],
        "properties": {
          "check": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C7",
              "C8"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
