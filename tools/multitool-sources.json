{
  "actionlint": {
    "repo": "rhysd/actionlint",
    "assets": {
      "macos_arm64": "actionlint_(?P<version>[0-9.]+)_darwin_arm64\\.tar\\.gz",
      "linux_x86_64": "actionlint_(?P<version>[0-9.]+)_linux_amd64\\.tar\\.gz",
      "linux_arm64": "actionlint_(?P<version>[0-9.]+)_linux_arm64\\.tar\\.gz"
    },
    "file": "actionlint"
  },
  "bats": {
    "repo": "bats-core/bats-core",
    "file": "bats-core-{version}/bin/bats"
  },
  "buildifier": {
    "repo": "bazel-contrib/buildtools",
    "assets": {
      "macos_arm64": "buildifier-darwin-arm64",
      "linux_x86_64": "buildifier-linux-amd64",
      "linux_arm64": "buildifier-linux-arm64"
    }
  },
  "editorconfig-checker": {
    "repo": "editorconfig-checker/editorconfig-checker",
    "assets": {
      "macos_arm64": "editorconfig-checker-darwin-all\\.tar\\.gz",
      "linux_x86_64": "editorconfig-checker-linux-amd64\\.tar\\.gz",
      "linux_arm64": "editorconfig-checker-linux-arm64\\.tar\\.gz"
    },
    "file": "editorconfig-checker"
  },
  "git": {
    "repo": "desktop/dugite-native",
    "assets": {
      "macos_arm64": "dugite-native-v(?P<version>[0-9.]+)-[0-9a-f]+-macOS-arm64\\.tar\\.gz",
      "linux_x86_64": "dugite-native-v(?P<version>[0-9.]+)-[0-9a-f]+-ubuntu-x64\\.tar\\.gz",
      "linux_arm64": "dugite-native-v(?P<version>[0-9.]+)-[0-9a-f]+-ubuntu-arm64\\.tar\\.gz"
    },
    "file": "bin/git"
  },
  "gitleaks": {
    "repo": "gitleaks/gitleaks",
    "assets": {
      "macos_arm64": "gitleaks_(?P<version>[0-9.]+)_darwin_arm64\\.tar\\.gz",
      "linux_x86_64": "gitleaks_(?P<version>[0-9.]+)_linux_x64\\.tar\\.gz",
      "linux_arm64": "gitleaks_(?P<version>[0-9.]+)_linux_arm64\\.tar\\.gz"
    },
    "file": "gitleaks"
  },
  "rumdl": {
    "repo": "rvben/rumdl",
    "assets": {
      "macos_arm64": "rumdl-v(?P<version>[0-9.]+)-aarch64-apple-darwin\\.tar\\.gz",
      "linux_x86_64": "rumdl-v(?P<version>[0-9.]+)-x86_64-unknown-linux-gnu\\.tar\\.gz",
      "linux_arm64": "rumdl-v(?P<version>[0-9.]+)-aarch64-unknown-linux-gnu\\.tar\\.gz"
    },
    "file": "rumdl"
  },
  "ryl": {
    "repo": "owenlamont/ryl",
    "assets": {
      "macos_arm64": "ryl-aarch64-apple-darwin\\.tar\\.gz",
      "linux_x86_64": "ryl-x86_64-unknown-linux-gnu\\.tar\\.gz",
      "linux_arm64": "ryl-aarch64-unknown-linux-gnu\\.tar\\.gz"
    },
    "file": "ryl"
  },
  "shellcheck": {
    "repo": "koalaman/shellcheck",
    "assets": {
      "macos_arm64": "shellcheck-v(?P<version>[0-9.]+)\\.darwin\\.aarch64\\.tar\\.xz",
      "linux_x86_64": "shellcheck-v(?P<version>[0-9.]+)\\.linux\\.x86_64\\.tar\\.xz",
      "linux_arm64": "shellcheck-v(?P<version>[0-9.]+)\\.linux\\.aarch64\\.tar\\.xz"
    },
    "file": "shellcheck-v{version}/shellcheck"
  },
  "shfmt": {
    "repo": "mvdan/sh",
    "assets": {
      "macos_arm64": "shfmt_v(?P<version>[0-9.]+)_darwin_arm64",
      "linux_x86_64": "shfmt_v(?P<version>[0-9.]+)_linux_amd64",
      "linux_arm64": "shfmt_v(?P<version>[0-9.]+)_linux_arm64"
    }
  },
  "tombi": {
    "repo": "tombi-toml/tombi",
    "assets": {
      "macos_arm64": "tombi-cli-(?P<version>[0-9.]+)-aarch64-apple-darwin\\.tar\\.gz",
      "linux_x86_64": "tombi-cli-(?P<version>[0-9.]+)-x86_64-unknown-linux-musl\\.tar\\.gz",
      "linux_arm64": "tombi-cli-(?P<version>[0-9.]+)-aarch64-unknown-linux-musl\\.tar\\.gz"
    },
    "file": {
      "macos_arm64": "tombi-cli-{version}-aarch64-apple-darwin/tombi",
      "linux_x86_64": "tombi-cli-{version}-x86_64-unknown-linux-musl/tombi",
