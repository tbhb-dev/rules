  "vale": {
    "repo": "vale-cli/vale",
    "assets": {
      "macos_arm64": "vale_(?P<version>[0-9.]+)_macOS_arm64\\.tar\\.gz",
      "linux_x86_64": "vale_(?P<version>[0-9.]+)_Linux_64-bit\\.tar\\.gz",
      "linux_arm64": "vale_(?P<version>[0-9.]+)_Linux_arm64\\.tar\\.gz"
    },
    "file": "vale"
  },
  "zizmor": {
    "repo": "zizmorcore/zizmor",
    "assets": {
      "macos_arm64": "zizmor-aarch64-apple-darwin\\.tar\\.gz",
      "linux_x86_64": "zizmor-x86_64-unknown-linux-gnu\\.tar\\.gz",
      "linux_arm64": "zizmor-aarch64-unknown-linux-gnu\\.tar\\.gz"
    },
    "file": "zizmor"
  }
}
