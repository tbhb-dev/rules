"""Proves cspell_test coexists with a consumer's own rules_js: its own `npm` hub and a different Node major (24, against the rules_nodejs default 22)."""

module(name = "cspell_coexist")

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "../..",
)

# This consumer uses rules_js itself: its own Node major and its own hub
# under the conventional name.
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")
