load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@tbhb_rules//lint:defs.bzl", "cspell_test")
load("@tbhb_rules//testing:defs.bzl", "expect_failure_test")

npm_link_all_packages(name = "node_modules")

# The consumer's own JS, on its own Node and its own `npm` hub.
js_test(
    name = "consumer_node",
    data = [":node_modules/ms"],
    entry_point = "version.js",
)

cspell_test(
    name = "cspell_clean",
    srcs = glob(
        ["testdata/clean/**"],
        exclude = [
            "testdata/clean/.cspell.jsonc",
            "testdata/clean/words.txt",
        ],
    ),
    config = "testdata/clean/.cspell.jsonc",
    data = ["testdata/clean/words.txt"],
    strip_prefix = "testdata/clean",
)

cspell_test(
    name = "cspell_bad",
    srcs = glob(["testdata/bad/**"]),
    config = "testdata/bad/.cspell.jsonc",
    strip_prefix = "testdata/bad",
    tags = ["manual"],
)

expect_failure_test(
    name = "cspell_bad_is_found",
    pattern = "notes\\.md:3:[0-9]+ - Unknown word \\(sentance\\)",
    test = ":cspell_bad",
)
