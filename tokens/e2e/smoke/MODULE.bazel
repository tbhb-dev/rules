"""Consumes tbhb_rules_tokens the way a design system repository would.

A token package in a subpackage: a resolver over base tokens, a light and
dark palette layer from Radix Colors (generated with radix_palettes and
committed with write_source_files), two themes that map roles onto the
palettes, and semantic tokens over the roles. It is checked with
tokens_test and built with tokens_css, with proofs that the check refuses
an unresolved alias, a cycle, a theme missing a role token and a contrast
pair below AA, and that the palette freshness test fails on an edited file.
"""

module(name = "tbhb_rules_tokens_smoke")

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "../../..",
)

bazel_dep(name = "tbhb_rules_tokens")
local_path_override(
    module_name = "tbhb_rules_tokens",
    path = "../..",
)

local_path_override(
    module_name = "tbhb_rules_typescript",
    path = "../../../typescript",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# The browser test of tokens_css's output: the pinned Chromium headless
# shell, driven by this module's own playwright-core.
bazel_dep(name = "tbhb_rules_playwright")
local_path_override(
    module_name = "tbhb_rules_playwright",
    path = "../../../playwright",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
    lifecycle_hooks = {"*": []},
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "12.16.1",
    pnpm_version_integrity = "sha512-CR0d7nknV1Zhsl2rPCrjHK/BxU1rce1qZgDPDByxBDSkR+rhQBXxsj4ua+3u1535SpMuIWTSgyKA3OP7MvZW0Q==",
)
use_repo(pnpm, "pnpm")
