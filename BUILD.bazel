# shfmt reads its style from .editorconfig.
tree_check_test(
    name = "shfmt_test",
    srcs = [":repo_files"],
    tool = "@tbhb_rules_shfmt//:shfmt",
    tool_args = ["-d"] + SHELL_SCRIPTS,
)

# Formatting: `bazel run //:format` rewrites, `bazel run //:format.check`
# checks the working tree, and format_test is the cached check in `bazel
# test //...`. The runner templates are bash with a .tpl suffix; shfmt
# takes their dialect from .editorconfig (shell_variant), because any
# parser flag would make it ignore .editorconfig altogether.
formatter(
    name = "shfmt_templates",
    include = ["*.sh.tpl"],
    check_args = ["-d"],
    fix_args = ["-w"],
    tool = "@tbhb_rules_shfmt//:shfmt",
)

FORMATTERS = [
    ":shfmt_templates",
    "//format:buildifier",
    "//format:rumdl",
    "//format:ryl",
    "//format:shfmt",
    "//format:tombi",
]

# Test fixtures hold deliberately malformed files, which no formatter may
# fix, and pnpm writes its own lockfiles. The nested modules are workspaces
# of their own, which format themselves with these same formatters.
FORMAT_EXCLUDE = [
    "*/testdata/*",
    "ansible/*",
    "astro/*",
    "cloudflare/*",
    "diagrams/d2/*",
    "go/*",
    "playwright/*",
    "pnpm-lock.yaml",
    "python/*",
    "storybook/*",
    "tokens/*",
    "typescript/*",
]

format(
    name = "format",
    exclude = FORMAT_EXCLUDE,
    formatters = FORMATTERS,
)

format_test(
    name = "format_test",
    srcs = [":repo_files"],
    exclude = FORMAT_EXCLUDE,
    formatters = FORMATTERS,
)

