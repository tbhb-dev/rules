# Every file of the repository, for the whole-tree checks below. Ignored
# directories are listed in REPO.bazel; these are the gitignored files that
# can sit at the root of a working checkout.
# The nested modules (ansible/, astro/, cloudflare/, diagrams/d2/, go/,
# playwright/, python/, storybook/, tokens/, typescript/) and the e2e
# consumers are .bazelignored workspaces of their own, with their own checks.
repo_files(
    exclude = [
        ".DS_Store",
        "**/.DS_Store",
        # The gitignored PR draft, which the PR script lints itself.
        ".github/PULL_REQUEST_DRAFT.md",
        ".bazelrc.user",
        ".coverage*",
        ".env*",
        "coverage.*",
        "mise.local.toml",
    ],
    exclude_subpackages = [
        "ansible/**",
        "astro/**",
        "cloudflare/**",
        "diagrams/d2/**",
        "e2e/**",
        "go/**",
        "playwright/**",
        "python/**",
        "storybook/**",
        "tokens/**",
        "typescript/**",
    ],
)

# Generates preset.bazelrc, which .bazelrc imports. The content depends on the
# Bazel version that runs the generator; the committed copy matches
# .bazelversion, and `preset.update_test` fails when it is stale.
bazelrc_preset(
    name = "preset",
)

# buildifier: `//:buildifier` formats and applies lint fixes in place,
# `//:buildifier.check` fails on any formatting or lint difference, and the
# test below makes `bazel test //...` fail on the same findings. Every
# available warning is on.
BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.venv/*",
    "./.mise/*",
    "./.bazel-*",
    "./bazel-*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    lint_warnings = ["all"],
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    mode = "diff",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

