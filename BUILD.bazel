load("@bazelrc-preset.bzl", "bazelrc_preset")
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("//format:defs.bzl", "format", "format_test", "formatter")
load(
    "//lint:defs.bzl",
    "actionlint_test",
    "bats_test",
    "editorconfig_checker_test",
    "gitleaks_test",
    "rumdl_test",
    "ryl_test",
    "tombi_test",
    "tree_check_test",
    "zizmor_test",
)
load("//repo:defs.bzl", "repo_files")

exports_files(["multitool.lock.json"])

# Every file of the repository, for the whole-tree checks below. Ignored
# directories are listed in REPO.bazel; these are the gitignored files that
# can sit at the root of a working checkout.
# The nested modules (go/, python/) and the e2e consumers are .bazelignored
# workspaces of their own, with their own checks.
repo_files(
    exclude = [
        ".DS_Store",
        "**/.DS_Store",
        ".bazelrc.user",
        ".coverage*",
        ".env*",
        "coverage.*",
        "mise.local.toml",
    ],
    exclude_subpackages = [
        "e2e/**",
        "go/**",
        "python/**",
    ],
)

# Generates preset.bazelrc, which .bazelrc imports. The content depends on the
# Bazel version that runs the generator; the committed copy matches
# .bazelversion, and `preset.update_test` fails when it is stale.
bazelrc_preset(
    name = "preset",
)

# buildifier: `//:buildifier` formats and applies lint fixes in place,
# `//:buildifier.check` fails on any formatting or lint difference, and the
# test below makes `bazel test //...` fail on the same findings. Every
# available warning is on.
BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.venv/*",
    "./.mise/*",
    "./bazel-*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    lint_warnings = ["all"],
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    mode = "diff",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

# This repository's own gates, built on its own rules.
gitleaks_test(
    name = "gitleaks_test",
    srcs = [":repo_files"],
    config = ".gitleaks.toml",
)

ryl_test(
    name = "ryl_test",
    srcs = [":repo_files"],
    config = ".ryl.toml",
)

tombi_test(
    name = "tombi_test",
    srcs = [":repo_files"],
    config = "tombi.toml",
    schemas = {
        "https://www.schemastore.org/partial-pytest.json": "@schemastore_partial_pytest//file",
        "https://www.schemastore.org/ruff.json": "@schemastore_ruff//file",
        "https://www.schemastore.org/uv.json": "@schemastore_uv//file",
    },
)

rumdl_test(
    name = "rumdl_test",
    srcs = [":repo_files"],
    config = ".rumdl.toml",
)

editorconfig_checker_test(
    name = "editorconfig_checker_test",
    srcs = [":repo_files"],
    config = ".editorconfig-checker.json",
)

actionlint_test(
    name = "actionlint_test",
    srcs = [":repo_files"],
)

zizmor_test(
    name = "zizmor_test",
    srcs = [":repo_files"],
    config = ".github/zizmor.yml",
)

# Shell scripts. A shebang-based selection rule is planned for lint/; until
# it lands, the scripts are listed here.
SHELL_SCRIPTS = [
    "lint/private/tree_check.sh.tpl",
    "testing/private/expect_failure.sh.tpl",
    "testing/tests/subject.sh",
    "tools/interim/install.bats",
    "tools/interim/install.sh",
]

tree_check_test(
    name = "shellcheck_test",
    srcs = [":repo_files"],
    tool = "@multitool//tools/shellcheck",
    tool_args = [
        "-o",
        "check-extra-masked-returns",
    ] + SHELL_SCRIPTS,
)

# shfmt reads its style from .editorconfig.
tree_check_test(
    name = "shfmt_test",
    srcs = [":repo_files"],
    tool = "@multitool//tools/shfmt",
    tool_args = ["-d"] + SHELL_SCRIPTS,
)

bats_test(
    name = "bats_test",
    srcs = [":repo_files"],
    tests = ["tools/interim/install.bats"],
)

# Formatting: `bazel run //:format` rewrites, `bazel run //:format.check`
# checks the working tree, and format_test is the cached check in `bazel
# test //...`. The runner templates are bash with a .tpl suffix; shfmt
# takes their dialect from .editorconfig (shell_variant), because any
# parser flag would make it ignore .editorconfig altogether.
formatter(
    name = "shfmt_templates",
    include = ["*.sh.tpl"],
    check_args = ["-d"],
    fix_args = ["-w"],
    tool = "@multitool//tools/shfmt",
)

FORMATTERS = [
    ":shfmt_templates",
    "//format:buildifier",
    "//format:rumdl",
    "//format:ryl",
    "//format:shfmt",
    "//format:tombi",
]

# Test fixtures hold deliberately malformed files, which no formatter may
# fix.
FORMAT_EXCLUDE = ["*/testdata/*"]

format(
    name = "format",
    exclude = FORMAT_EXCLUDE,
    formatters = FORMATTERS,
)

format_test(
    name = "format_test",
    srcs = [":repo_files"],
    exclude = FORMAT_EXCLUDE,
    formatters = FORMATTERS,
)
