load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@tbhb_rules//format:defs.bzl", "format", "format_test")
load(
    "@tbhb_rules//lint:defs.bzl",
    "editorconfig_checker_test",
    "gitleaks_test",
    "rumdl_test",
    "ryl_test",
    "shellcheck_test",
    "shfmt_test",
    "tombi_test",
)
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("//private:formatter_include.bzl", "formatter_include")

repo_files(
    exclude = [
        ".DS_Store",
        "**/.DS_Store",
        ".bazelrc.user",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//private:d2_diagrams"],
)

# This module is released on its own (strip_prefix diagrams/d2/), so it
# carries its own copies of the parent module's lint configs. Each copy must
# match the parent's byte for byte; a change goes to both. .gitignore and
# .rylignore are this module's own (.ryl.toml reads them).
LINT_CONFIGS = [
    ".editorconfig",
    ".editorconfig-checker.json",
    ".gitleaks.toml",
    ".rumdl.toml",
    ".ryl.toml",
    "tombi.toml",
]

[
    diff_test(
        name = "config_matches_parent_" + config.lstrip(".").replace(".", "_").replace("-", "_"),
        file1 = config,
        file2 = "@tbhb_rules//:" + config,
    )
    for config in LINT_CONFIGS
]

# The parent module's whole-tree checks, over this module's files.
gitleaks_test(
    name = "gitleaks_test",
    srcs = [":repo_files"],
    config = ".gitleaks.toml",
)

ryl_test(
    name = "ryl_test",
    srcs = [":repo_files"],
    config = ".ryl.toml",
)

tombi_test(
    name = "tombi_test",
    srcs = [":repo_files"],
    config = "tombi.toml",
)

rumdl_test(
    name = "rumdl_test",
    srcs = [":repo_files"],
    config = ".rumdl.toml",
)

editorconfig_checker_test(
    name = "editorconfig_checker_test",
    srcs = [":repo_files"],
    config = ".editorconfig-checker.json",
)

# This module's own formatting: `bazel run //:format` rewrites the tree,
# `//:format.check` and `format_test` check it, with the parent module's
# formatters. shfmt takes the bash dialect of the templates from
# .editorconfig.
formatter_include(
    name = "shfmt_templates",
    include = ["*.sh.tpl"],
    formatter = "@tbhb_rules//format:shfmt",
)

FORMATTERS = [
    ":shfmt_templates",
    "@tbhb_rules//format:buildifier",
    "@tbhb_rules//format:rumdl",
    "@tbhb_rules//format:ryl",
    "@tbhb_rules//format:shfmt",
    "@tbhb_rules//format:tombi",
]

format(
    name = "format",
    formatters = FORMATTERS,
)

format_test(
    name = "format_test",
    srcs = [":repo_files"],
    formatters = FORMATTERS,
)

# Shell scripts and templates (found by extension or shebang), held to the
# parent module's bar. shfmt takes its style from .editorconfig.
shellcheck_test(
    name = "shellcheck_test",
    srcs = [":repo_files"],
)

shfmt_test(
    name = "shfmt_test",
    srcs = [":repo_files"],
)
