load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("//:defs.bzl", "structurizr_workspace")

repo_files()

# The script prints a line while the command-line tool reads the workspace, so
# a clean inspection is not silent. Lint must still pass. The suite lists the
# manual lint test so that it runs.
structurizr_workspace(
    name = "workspace",
    data = glob([
        "testdata/documentation/**",
        "testdata/decisions/**",
    ]),
    diagrams_dir = "testdata/diagrams",
    dsl = "testdata/workspace.dsl",
    tags = ["manual"],
    workspace_json = "testdata/workspace.json",
)

test_suite(
    name = "accepts_other_output",
    tests = [":workspace_lint_test"],
)
