load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("@tbhb_rules//testing:defs.bzl", "expect_failure_test")
load("//:defs.bzl", "structurizr_workspace")

repo_files()

structurizr_workspace(
    name = "workspace",
    data = glob([
        "testdata/documentation/**",
        "testdata/decisions/**",
    ]),
    diagrams_dir = "testdata/diagrams",
    dsl = "testdata/workspace.dsl",
    tags = ["manual"],
    workspace_json = "testdata/workspace.json",
)

expect_failure_test(
    name = "rejects_stale_png",
    exit_status = 1,
    first_line = True,
    pattern = "^stale: diagrams/structurizr\\-containers\\-key\\.png differs from a fresh render$",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
    test = ":workspace_png_test",
)
