"""Structurizr workspaces, exported and checked offline."""

module(
    name = "tbhb_rules_structurizr",
    version = "0.0.0",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

tools = use_extension("@tbhb_rules//pins:extensions.bzl", "tools")
use_repo(tools, "tbhb_rules_jre", "tbhb_rules_plantuml", "tbhb_rules_structurizr_cli")
