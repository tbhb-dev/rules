"""TypeScript rules for tbhb-dev repositories: tsc type checking, the Biome
linter and formatter, type-aware typescript-eslint, knip,
dependency-cruiser, Vitest with coverage, Stryker mutation testing and pnpm
audit.

Consumers load only `@tbhb_rules_typescript//:defs.bzl`.
"""

module(
    name = "tbhb_rules_typescript",
    version = "0.0.0",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "tbhb_rules")

# The released module resolves tbhb_rules from the registry; inside this
# repository it is the enclosing module.
local_path_override(
    module_name = "tbhb_rules",
    path = "..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_lib", version = "3.7.0")

# The toolchain every check runs (TypeScript, Biome, ESLint and
# typescript-eslint, knip, dependency-cruiser, Vitest, Stryker and pnpm),
# installed by rules_js from this module's pnpm lock under a private hub, so
# a consumer's own npm hubs never meet it. Biome's native binary comes as its
# per-platform optional package. Every package is pinned by integrity hash
# and no lifecycle script runs. Like tbhb_rules, this module registers no
# Node toolchain; the root module controls it. The lock sits at the module
# root to keep the store's paths under Windows' 260-character limit.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "tbhb_rules_typescript_npm",
    data = ["//:package.json"],
    lifecycle_hooks = {"*": []},
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "tbhb_rules_typescript_npm")

# Dev dependencies: this module's own tests.
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

# The pnpm that rules_js pins, for maintainers regenerating the lock:
# bazel run -- @pnpm//:pnpm --dir "$PWD" install --lockfile-only
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")
