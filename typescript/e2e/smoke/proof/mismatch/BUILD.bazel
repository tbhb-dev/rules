load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("@tbhb_rules//testing:defs.bzl", "expect_failure_test")
load("@tbhb_rules_typescript//:defs.bzl", "vitest_test")

repo_files()

# Planted: a node_modules whose vitest isn't the module's pin. The launcher
# refuses to run two Vitests in one tree.
filegroup(
    name = "node_modules",
    srcs = glob(["node_modules/**"]),
)

vitest_test(
    name = "proof_vitest_version_mismatch",
    srcs = ["//:src/greeting.test.ts"],
    node_modules = [":node_modules"],
    tags = ["manual"],
)

expect_failure_test(
    name = "proof_vitest_version_mismatch_fails",
    # Any pinned version, so a Vitest bump doesn't have to edit this proof.
    pattern = "the consumer's node_modules has its own vitest 4.0.0 \\(this module pins [0-9.]+\\)",
    test = ":proof_vitest_version_mismatch",
)
