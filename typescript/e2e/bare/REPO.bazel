# Directories that hold no source, kept out of every glob so //:repo_files
# never scans them: Bazel's convenience symlinks and local tool state (the
# same list in every workspace of tbhb_rules).
ignore_directories([
    # Bazel convenience symlinks (--symlink_prefix=.bazel-). The old bazel-*
    # links stay listed for one transition: clones that have not run Bazel
    # since the prefix change still have them.
    ".bazel-*",
    "bazel-*",
    "**/.bazel_env",
    ".claude/worktrees",
    "**/.venv",
    "mutants",
    "tmp",
    "**/__pycache__",
    "**/.*_cache",
    ".hypothesis",
])
