"""Ansible checks over a copy of the tree.

Each check builds on tbhb_rules' `tree_check_test`: the tool runs at the
root of a dereferenced copy of `srcs`, laid out at repository-relative
paths (relative to `strip_prefix` when set), so it reads the tree's
ansible.cfg and lint config as it would in a checkout. ansible-core,
ansible-lint and molecule come from a locked Python environment: by
default `@tbhb_ansible//:env`, which is the root module's
`ansible.toolchain` project, or else this module's own pins. The pinned
collections (`ansible.collections`) are the only ones the tools see.
"""

load("@bazel_skylib//lib:shell.bzl", "shell")
load("@tbhb_rules//lint:defs.bzl", "tree_check_test")
load("@tbhb_rules//runtime:defs.bzl", "python_tool")

# Internal: consumers load //:defs.bzl.
visibility("//...")

DEFAULT_ENV = Label("@tbhb_ansible//:env")
_COLLECTIONS = Label("@tbhb_ansible_collections//:tree")
_DRIVER = Label("//private:ansible_check.py")
_LINT_CONFIG = Label("//private:ansible-lint.yml")
_LOCK_SCRIPT = Label("//private:collections_lock.py")
_LOCK_ENV = Label("@tbhb_rules_python_runtime//:env")

# ansible-core does not run on Windows (its controller needs fork and a
# POSIX terminal), so the checks are incompatible there and `bazel test
# //...` skips them. Label() resolves @platforms in this module, so a
# consumer needs no platforms dependency of its own.
NOT_WINDOWS = select({
    Label("@platforms//os:windows"): [Label("@platforms//:incompatible")],
    "//conditions:default": [],
})

# Molecule's Docker driver runs Linux containers on the host's daemon.
_LINUX_ONLY = select({
    Label("@platforms//os:linux"): [],
    "//conditions:default": [Label("@platforms//:incompatible")],
})

def _rlocation(file):
    """The path of `file` under the runfiles root."""
    if file.short_path.startswith("../"):
        return file.short_path[len("../"):]
    return "_main/" + file.short_path

def _ansible_tool_impl(ctx):
    # Each collection repository holds ansible_collections/<ns>/<name>/,
    # so its root is one entry of ANSIBLE_COLLECTIONS_PATH.
    roots = {}
    for f in ctx.files.collections:
        roots[_rlocation(f).partition("/")[0]] = True
    launcher = ctx.attr.launcher[DefaultInfo].files_to_run.executable
    script = ctx.actions.declare_file(ctx.label.name)
    ctx.actions.write(
        output = script,
        is_executable = True,
        content = """#!/usr/bin/env bash
# Generated by tbhb_rules_ansible: the pinned collections and the default
# lint config, in the test's runfiles, for ansible_check.py.
set -euo pipefail
runfiles=${{TEST_SRCDIR:?the Ansible checks run as tests}}
collections=""
for root in {roots}; do
  collections+="${{collections:+:}}$runfiles/$root"
done
export TBHB_ANSIBLE_COLLECTIONS=$collections
export TBHB_ANSIBLE_LINT_DEFAULT_CONFIG="$runfiles/"{config}
exec "$runfiles/"{launcher} "$@"
""".format(
            config = shell.quote(_rlocation(ctx.file.lint_config)),
            launcher = shell.quote(_rlocation(launcher)),
            roots = " ".join([shell.quote(r) for r in sorted(roots)]),
        ),
    )
    runfiles = ctx.runfiles(files = [launcher, ctx.file.lint_config] + ctx.files.collections)
    runfiles = runfiles.merge(ctx.attr.launcher[DefaultInfo].default_runfiles)
    return [DefaultInfo(executable = script, runfiles = runfiles)]

_ansible_tool = rule(
    implementation = _ansible_tool_impl,
    executable = True,
    attrs = {
        "collections": attr.label(default = _COLLECTIONS, allow_files = True),
        "launcher": attr.label(mandatory = True, executable = True, cfg = "target"),
        "lint_config": attr.label(default = _LINT_CONFIG, allow_single_file = True),
    },
)

def _check(name, srcs, tool_args, python_env, target_compatible_with, **kwargs):
    common = {
        "tags": ["manual"],
        "target_compatible_with": target_compatible_with,
        "testonly": True,
        "visibility": ["//visibility:private"],
    }
    python_tool(
        name = name + ".launcher",
        main = _DRIVER,
        python_env = python_env,
        **common
    )
    _ansible_tool(
        name = name + ".tool",
        launcher = ":{}.launcher".format(name),
        **common
    )
    tree_check_test(
        name = name,
        srcs = srcs,
        tool = ":{}.tool".format(name),
        tool_args = tool_args,
        target_compatible_with = target_compatible_with,
        **kwargs
    )

def ansible_syntax_check_test(name, srcs, playbooks, inventory, python_env = DEFAULT_ENV, **kwargs):
    """Checks that the inventory parses and each playbook passes `--syntax-check`.

    Runs `ansible-inventory --list -i <inventory>`, failing on any inventory
    source no plugin can parse, then `ansible-playbook --syntax-check -i
    <inventory>` per playbook, with the hermetic environment described in
    the module docstring: ANSIBLE_CONFIG is the tree's ansible.cfg (or an
    empty one), ANSIBLE_COLLECTIONS_PATH holds only the pinned
    collections, overriding any `collections_path` the config sets, and
    Ansible's home and temporary directories are under TEST_TMPDIR. A
    module or role from a collection that is not pinned fails the check.
    Linux and macOS only.

    Args:
        name: Target name.
        srcs: Files to copy, usually a `repo_files` target: the playbooks,
            inventory, roles and ansible.cfg.
        playbooks: Paths of the playbooks, relative to the tree root.
        inventory: Path of the inventory file or directory, relative to
            the tree root.
        python_env: The environment providing ansible-core, such as
            `@tbhb_python//:env` when the root uv project carries it.
        **kwargs: Passed to `tree_check_test`, such as `strip_prefix`.
    """
    if not playbooks:
        fail("ansible_syntax_check_test: name at least one playbook")
    target_compatible_with = kwargs.pop("target_compatible_with", NOT_WINDOWS)
    _check(name, srcs, ["syntax", "--inventory", inventory] + playbooks, python_env, target_compatible_with, **kwargs)

def ansible_lint_test(name, srcs, python_env = DEFAULT_ENV, config = None, args = [], **kwargs):
    """Runs ansible-lint, offline, over a copy of the tree.

    The config is `config` when set, else the tree's own `.ansible-lint`
    (or `.config/ansible-lint.yml`), else tbhb_rules_ansible's default:
    the production profile, offline, with the opt-in rules enabled by
    name. A consumer config replaces the default entirely, and the test
    log says which one ran. The environment is that of
    `ansible_syntax_check_test`, so ansible-lint resolves only the pinned
    collections. Linux and macOS only.

    Args:
        name: Target name.
        srcs: Files to copy, usually a `repo_files` target.
        python_env: The environment providing ansible-core and ansible-lint.
        config: An ansible-lint config file, overriding the tree's own.
        args: Extra ansible-lint arguments, such as paths to lint.
        **kwargs: Passed to `tree_check_test`, such as `strip_prefix`.
    """
    tool_args = ["lint"]
    if config:
        tool_args += ["--config", "{config}"]
    target_compatible_with = kwargs.pop("target_compatible_with", NOT_WINDOWS)
    _check(name, srcs, tool_args + args, python_env, target_compatible_with, config = config, **kwargs)

def molecule_test(name, srcs, scenario = "default", role = ".", python_env = DEFAULT_ENV, tags = [], **kwargs):
    """Runs `molecule test -s <scenario>` in a writable copy of a role.

    It needs a Docker daemon (DOCKER_HOST, inherited, or the default
    socket) that can run privileged systemd containers, and the network
    to pull images, so it is tagged manual, local, external,
    requires-network and exclusive, is never part of `//...`, and runs
    only when named: `bazel test //path/to:target`. Linux only.

    MOLECULE_EPHEMERAL_DIRECTORY and XDG_CACHE_HOME are under TEST_TMPDIR,
    and Ansible sees the pinned collections only, as in
    `ansible_syntax_check_test`: pin the collections the driver needs
    (community.docker for Docker) and turn off the scenario's `dependency`
    step, since nothing is installed at test time.

    Args:
        name: Target name.
        srcs: Files to copy: the role, its molecule/ directory and any
            ansible.cfg at the tree root.
        scenario: The Molecule scenario.
        role: The role's directory, relative to the tree root, that
            Molecule runs from.
        python_env: The environment providing ansible-core, molecule and
            molecule-plugins[docker].
        tags: More tags.
        **kwargs: Passed to `tree_check_test`, such as `strip_prefix`.
    """
    env_inherit = kwargs.pop("env_inherit", []) + ["DOCKER_HOST"]
    target_compatible_with = kwargs.pop("target_compatible_with", _LINUX_ONLY)
    _check(
        name,
        srcs,
        ["molecule", "--role", role, "--scenario", scenario],
        python_env,
        target_compatible_with,
        env_inherit = env_inherit,
        tags = ["manual", "local", "external", "requires-network", "exclusive"] + tags,
        **kwargs
    )

def _tree_path(label, strip_prefix):
    label = native.package_relative_label(label)
    path = label.name if not label.package else label.package + "/" + label.name
    prefix = strip_prefix.strip("/")
    if not prefix:
        return path
    if not path.startswith(prefix + "/"):
        fail("{} is not under strip_prefix {}".format(label, prefix))
    return path[len(prefix) + 1:]

def ansible_collections_lock_test(name, requirements, lock, **kwargs):
    """Fails when requirements.yml and requirements.lock.json disagree.

    The pins must be exact (a range is an error) and the lock must hold
    the same collections at the same versions, each with its URL and
    sha256. The failure names the fix: `bazelisk run
    @tbhb_rules_ansible//:lock`. It reads only the two files, so it runs
    offline, on every platform.

    Args:
        name: Target name.
        requirements: The requirements.yml file.
        lock: The requirements.lock.json file.
        **kwargs: Passed to `tree_check_test`, such as `strip_prefix`.
    """
    strip_prefix = kwargs.get("strip_prefix", "")
    python_tool(
        name = name + ".tool",
        main = _LOCK_SCRIPT,
        python_env = _LOCK_ENV,
        tags = ["manual"],
        testonly = True,
        visibility = ["//visibility:private"],
    )
    tree_check_test(
        name = name,
        srcs = [requirements, lock],
        tool = ":{}.tool".format(name),
        tool_args = [
            "--check",
            "--requirements",
            _tree_path(requirements, strip_prefix),
            "--lock",
            _tree_path(lock, strip_prefix),
        ],
        **kwargs
    )
