# Directories that hold no source, kept out of every glob so //:repo_files
# never scans them: Bazel's convenience symlinks and local tool state (the
# same list in every workspace of tbhb_rules), and e2e/, which holds consumer modules with their own MODULE.bazel.
ignore_directories([
    "bazel-*",
    "**/.bazel_env",
    ".claude/worktrees",
    "**/.venv",
    "mutants",
    "tmp",
    "**/__pycache__",
    "**/.*_cache",
    ".hypothesis",
    "e2e",
])
