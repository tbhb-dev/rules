"""Python checks for tbhb-dev repositories, driven by uv.lock.

Consumers load only `@tbhb_rules_python//:defs.bzl`. See README.md.
"""

module(
    name = "tbhb_rules_python",
    version = "0.0.0",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "tbhb_rules", version = "0.0.0")

# The released module resolves tbhb_rules from the registry; inside this
# repository it is the enclosing module.
local_path_override(
    module_name = "tbhb_rules",
    path = "..",
)

# The Python environment built from the root module's uv.lock, which the
# rules here default to, so a consumer only declares its project; and this
# module's own tool pins (tools/uv.lock).
python = use_extension("//:extensions.bzl", "python")
use_repo(python, "tbhb_python", "tbhb_python_tools")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

# This module's own Python (private/*.py) is checked from its own project:
# pyproject.toml and uv.lock here, used only when this module is the root.
python_dev = use_extension("//:extensions.bzl", "python", dev_dependency = True)
python_dev.project()
