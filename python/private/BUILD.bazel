load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

exports_files([
    "import_linter.py",
    "mutmut.sh.tpl",
    "mutmut_report.py",
    "pip_audit.py",
])

bzl_library(
    name = "extension",
    srcs = ["extension.bzl"],
    visibility = ["//:__subpackages__"],
    deps = ["@tbhb_rules//runtime:defs"],
)

bzl_library(
    name = "tool",
    srcs = ["tool.bzl"],
    visibility = ["//:__subpackages__"],
    deps = ["@tbhb_rules//runtime:defs"],
)

bzl_library(
    name = "checks",
    srcs = ["checks.bzl"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":tool",
        "@tbhb_rules//lint:defs",
    ],
)

bzl_library(
    name = "mutmut",
    srcs = ["mutmut.bzl"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":tool",
        "@tbhb_rules//quality:defs",
    ],
)
