"""Consumes tbhb_rules_cloudflare the way a Worker repository would.

A small Worker with an R2 binding, a variable and an npm package of its
own, bundled for two environments, with its generated types checked and
type-checked, and proofs that the checks fail on planted defects.
"""

module(name = "tbhb_rules_cloudflare_smoke")

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "../../..",
)

bazel_dep(name = "tbhb_rules_cloudflare")
local_path_override(
    module_name = "tbhb_rules_cloudflare",
    path = "../..",
)

bazel_dep(name = "tbhb_rules_typescript")
local_path_override(
    module_name = "tbhb_rules_typescript",
    path = "../../../typescript",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# The project's own packages, as a consumer installs them.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = ["//:package.json"],
    lifecycle_hooks = {"*": []},
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")
