{
  "name": "smoke",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "vars": { "GREETING": "hello" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "smoke" }],
  "env": {
    "stg": {
      "name": "smoke-stg",
      "workers_dev": false,
      "vars": { "GREETING": "hello" },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "smoke-stg" }]
    }
  }
}
