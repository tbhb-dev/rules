"""Swift and Apple rules for tbhb-dev repositories: Swift libraries, iOS
simulator apps, macOS apps and their unit tests under rules_swift and
rules_apple, with SwiftLint and the repository's strict compiler flag sets.

Xcode is the one toolchain Bazel doesn't bring: it comes from the host,
through apple_support's Xcode config, so everything here needs a Mac. No
macro signs anything or uses a provisioning profile.

Consumers load only `@tbhb_rules_swift//:defs.bzl`.
"""

module(
    name = "tbhb_rules_swift",
    version = "0.0.0",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "..",
)

# The versions the smoke consumer proved with Xcode 27.2 and Bazel 9.3.2;
# the macros are tested against exactly these, and a consumer should stay on
# them or newer.
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# SwiftLint's release binary (a universal macOS executable), pinned by sha256
# so Bazel fetches it and no PATH or Homebrew copy is involved. Renovate's
# bazel-module manager moves the version in the URL; the sha256 moves with it.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "tbhb_rules_swiftlint",
    build_file_content = 'exports_files(["swiftlint"], visibility = ["//visibility:public"])',
    sha256 = "c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0",
    url = "https://github.com/realm/SwiftLint/releases/download/0.65.1/portable_swiftlint.zip",
)
