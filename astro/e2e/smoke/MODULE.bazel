"""Consumes tbhb_rules_astro the way a site repository would.

A one-page Astro site in a subpackage, whose astro comes from the root pnpm lock, built with
astro_build and checked with astro_check_test, with proofs that the check
fails on a planted type error and on a tree with no .astro file.
"""

module(name = "tbhb_rules_astro_smoke")

bazel_dep(name = "tbhb_rules")
local_path_override(
    module_name = "tbhb_rules",
    path = "../../..",
)

bazel_dep(name = "tbhb_rules_astro")
local_path_override(
    module_name = "tbhb_rules_astro",
    path = "../..",
)

local_path_override(
    module_name = "tbhb_rules_typescript",
    path = "../../../typescript",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# The project's own packages, as a consumer installs them.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
    lifecycle_hooks = {"*": []},
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "12.16.1",
    pnpm_version_integrity = "sha512-CR0d7nknV1Zhsl2rPCrjHK/BxU1rce1qZgDPDByxBDSkR+rhQBXxsj4ua+3u1535SpMuIWTSgyKA3OP7MvZW0Q==",
)
use_repo(pnpm, "pnpm")
