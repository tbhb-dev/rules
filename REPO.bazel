# Directories that hold no source of this repository: VCS metadata, Python
# environments, tool caches and mutation output. Ignoring them keeps them out
# of every package and every glob, so whole-tree checks (//:repo_files)
# never scan them.
ignore_directories([
    ".git",
    "bazel-*",
    ".mise",
    ".venv",
    "mutants",
    "tmp",
    "**/__pycache__",
    "**/.*_cache",
    ".hypothesis",
])
