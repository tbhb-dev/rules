{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#c993c230872876912187a2fb8df69d94778be799", // main
    "github>tbhb-dev/renovate-config//bazel.json5#c993c230872876912187a2fb8df69d94778be799", // main
    "github>tbhb-dev/renovate-config//go.json5#c993c230872876912187a2fb8df69d94778be799", // main
    "github>tbhb-dev/renovate-config//python.json5#c993c230872876912187a2fb8df69d94778be799", // main
  ],

  // The presets cover the rest of this tree: the bazel manager the literal
  // http_archive and http_file pins (pins/extensions.bzl, go/private/tools.bzl,
  // diagrams/d2/private/tools.bzl, MODULE.bazel) and dugite's git, gomod the
  // go.mod requirements, tool directives and toolchain lines that
  // go_sdk.from_file reads, python.json5 the pyproject and uv.lock pins and
  // uv's required-version, npm the package.json and pnpm-lock.yaml pins
  // (lint/private/cspell, typescript/package.json with Biome's binaries,
  // cloudflare/package.json with wrangler, astro/package.json with
  // @astrojs/check, storybook/package.json, e2e consumers), and bazelisk
  // every .bazelversion as one group.
  packageRules: [
    {
      // The govulncheck smoke test needs a module with known
      // vulnerabilities to find, so its golang.org/x/text pin stays put.
      description: "The govulncheck smoke fixture keeps its vulnerable pin",
      matchFileNames: ["go/e2e/smoke/govulncheck/go.mod"],
      enabled: false,
    },
    {
      description: "typescript-eslint 8 supports TypeScript below 6.1 (peer >=4.8.4 <6.1.0)",
      matchFileNames: ["typescript/**/package.json"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<6.1",
    },
    {
      description: "astro check refuses TypeScript 7 (\"install TypeScript 6 instead\")",
      matchFileNames: ["astro/**/package.json"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      // The coverage packages require Vitest's exact version, and each
      // @cloudflare/vitest-plugin release depends on one exact wrangler,
      // whose workerd runs the tests; the Cloudflare module's wrangler
      // generates the Worker types and deploys, from its own workerd.
      // tbhb_rules_storybook's story tests run on the same Vitest, through
      // @vitest/browser-playwright, whose playwright must drive the
      // browsers tbhb_rules_playwright pins for one playwright-core. One
      // group keeps them all on one Vitest, one workerd and one Playwright.
      description: "Vitest, its plugins, Playwright and wrangler move together",
      matchFileNames: [
        "typescript/**/package.json",
        "cloudflare/**/package.json",
        "playwright/**/package.json",
        "storybook/**/package.json",
      ],
      matchPackageNames: [
        "vitest",
        "@vitest/**",
        "@cloudflare/vitest-plugin",
        "wrangler",
        "playwright",
        "playwright-core",
      ],
      groupName: "vitest, playwright and workerd",
    },
    {
      // A wrangler bump that moves workerd changes every Worker's generated
      // types, which worker_types_test then fails on until they're
      // regenerated on the bump's branch.
      description: "wrangler bumps need regenerated Worker types",
      matchFileNames: ["cloudflare/**/package.json"],
      matchPackageNames: ["wrangler"],
      prBodyNotes: [
        "Regenerate the smoke Worker's types on this branch before merging: `cd cloudflare/e2e/smoke && bazel run //:worker_types_test.update`, then commit `worker-configuration.d.ts`. Until then `worker_types_test` fails, as expected.",
      ],
    },
    {
      // typescript/launch.mjs lists the plugin's security rules by name,
      // because the plugin carries no rule category.
      description: "eslint-plugin-sonarjs bumps need the security rule list checked",
      matchFileNames: ["typescript/**/package.json"],
      matchPackageNames: ["eslint-plugin-sonarjs"],
      prBodyNotes: [
        "Check `SONARJS_SECURITY` in typescript/launch.mjs against the new release: list the rules Sonar's rule metadata types VULNERABILITY (the comment there says how), add any new one and drop any the plugin removed, or ESLint fails with an unknown rule.",
      ],
    },
    {
      // tbhb_rules_playwright's browser archives come from Playwright's own
      // CDN, which no Renovate datasource reads, and belong to one
      // playwright-core release. Renovate moves playwright-core, and
      // tbhb_rules_storybook's playwright with it; playwright/e2e/smoke's
      // launch_test and storybook's versions_test then fail until the pins
      // match.
      description: "Playwright bumps need the browser pins moved",
      matchFileNames: ["playwright/**/package.json", "storybook/**/package.json"],
      matchPackageNames: ["playwright", "playwright-core"],
      prBodyNotes: [
        "Move the pins in playwright/private/browsers.bzl to the new playwright-core's browsers.json on this branch: PLAYWRIGHT_VERSION, the chromium-headless-shell revision and browser version, and each archive's URL and sha256. Until then `launch_test` in playwright/e2e/smoke and `//tests:versions_test` in storybook fail, as expected.",
      ],
    },
    {
      // Storybook's packages peer each other at one release, and
      // eslint-plugin-storybook, in tbhb_rules_typescript, follows it.
      description: "Storybook's packages move together",
      matchFileNames: ["typescript/**/package.json", "storybook/**/package.json"],
      matchPackageNames: ["storybook", "@storybook/**", "eslint-plugin-storybook"],
      groupName: "storybook",
    },
    {
      // tbhb_rules_d2's PNG font. 2.045R-ro/1.095R-it is the last Source
      // Sans Pro release; later ones are Source Sans 3, another family name
      // and asset layout, and the bazel manager would misread the tag's
      // slash anyway. A move to Source Sans 3 is a change to the renderer.
      description: "Source Sans Pro stays at its last release",
      matchPackageNames: ["adobe-fonts/source-sans"],
      enabled: false,
    },
    {
      // tbhb_rules_d2's monospace PNG font. Its release tags hold slashes
      // too, which the bazel manager would misread, so it moves by hand.
      description: "Source Code Pro moves by hand",
      matchPackageNames: ["adobe-fonts/source-code-pro"],
      enabled: false,
    },
  ],
  customManagers: [
    {
      // The runtime downloads uv at repository-fetch time from this dict, so
      // it isn't an http_archive call the bazel manager sees. Each entry
      // holds a literal (url, sha256) pair on one line. python.json5 groups
      // these with the required-version pin.
      customType: "regex",
      description: "uv release assets in runtime/private/versions.bzl, one (url, sha256) pair per entry",
      managerFilePatterns: ["/^runtime/private/versions\\.bzl$/"],
      matchStrings: [
        "\"https://github\\.com/(?<packageName>astral-sh/uv)/releases/download/(?<currentValue>[^/\"]+)/[^\"]+\",\\s*\"(?<currentDigest>[0-9a-f]{64})\"",
      ],
      depNameTemplate: "uv",
      datasourceTemplate: "github-release-attachments",
    },
  ],
}
